---
import { Image } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Navbar from '~/components/Navbar.astro';
import Footer from '~/components/Footer.astro';
import Contact from '~/components/Contact.astro';
import CmsIcon from '~/components/CmsIcon.astro';
import { orderedIndustriesData, type IndustryData } from '~/data/cms';
import heroBg from '~/assets/industry-hero-bg.png';
import teamBg from '~/assets/team-member-bg.png';

import { ArrowRight, ArrowLeft, CircleAlert, CircleCheckBig } from '@lucide/astro';

// Generate paths for all active industries at build time
export async function getStaticPaths() {
  return orderedIndustriesData.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props as { industry: IndustryData };
---

<Layout title={`${industry.title} Solutions - HTIS`}>
  <div class="relative w-full overflow-clip bg-base-100">
    <Navbar />

    <!-- Section 1: Hero Banner -->
    <section
      class="relative flex min-h-[550px] w-full items-center overflow-hidden pt-32 pb-20 md:min-h-[600px]"
    >
      <!-- Background Asset Layer -->
      <div class="absolute inset-0 z-0 opacity-100">
        <Image
          src={heroBg}
          alt=""
          aria-hidden="true"
          class="h-full w-full object-cover object-center"
          style="filter: var(--filter-invert-dark)"
        />
      </div>

      <!-- Hero Overlay Gradients for Readability -->
      <div
        class="absolute inset-0 z-0 bg-linear-to-r from-base-100/90 via-base-100/70 to-transparent lg:w-2/3"
      >
      </div>
      <div
        class="absolute inset-0 z-0 bg-linear-to-b from-transparent via-base-100/20 to-base-100"
      >
      </div>

      <div class="relative z-10 container mx-auto px-6">
        <!-- Back Navigation Link -->
        <div class="mb-8">
          <a
            href="/industry"
            class="hover:text-primary-focus group inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors"
          >
            <ArrowLeft class="h-4 w-4 transition-transform group-hover:-translate-x-1" />
            Back to Industries
          </a>
        </div>

        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
          <!-- Text Core Column -->
          <div class="space-y-6 text-left lg:col-span-7">
            <div
              class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-4 py-1.5 text-xs font-semibold tracking-wide text-primary uppercase md:text-sm"
            >
              HTIS Industry Solutions
            </div>

            <h1
              class="text-4xl leading-tight font-extrabold tracking-tight text-base-content md:text-5xl lg:text-6xl"
            >
              Empowering <br />
              <span class="text-primary">{industry.title}</span>
            </h1>

            <p
              class="max-w-xl text-lg leading-relaxed font-medium text-base-content/80 md:text-xl"
            >
              {industry.heroSubtitle}
            </p>

            <div class="flex flex-wrap gap-4 pt-4">
              <a
                href="#capabilities"
                class="btn rounded-full px-8 text-base font-semibold shadow-lg transition-all duration-300 btn-primary hover:shadow-primary/30"
              >
                Explore Capabilities
              </a>
              <a
                href="/#contact"
                class="btn rounded-full border-base-content/20 px-8 text-base font-semibold transition-all duration-300 btn-outline hover:border-primary"
              >
                Contact Experts
              </a>
            </div>
          </div>

          <!-- Dynamic Icon Showcase Column -->
          <div class="flex justify-center lg:col-span-5 lg:justify-end">
            <div class="group relative">
              <!-- Glow Rings -->
              <div
                class="absolute -inset-4 rounded-full bg-primary/10 opacity-75 blur-xl transition-opacity duration-500 group-hover:opacity-100"
              >
              </div>
              <div
                class="to-primary-focus absolute -inset-1 rounded-full bg-linear-to-r from-primary opacity-20 blur-md transition-transform duration-500 group-hover:scale-105"
              >
              </div>

              <!-- Central Icon Container -->
              <div
                class="relative flex h-44 w-44 items-center justify-center rounded-full border border-base-content/10 bg-base-100 text-primary shadow-2xl transition-transform duration-500 group-hover:scale-[1.03] md:h-52 md:w-52"
              >
                <CmsIcon
                  name={industry.iconName}
                  className="h-20 w-20 stroke-[1.5] md:h-24 md:w-24"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Industry Challenges -->
    <section class="relative overflow-hidden bg-base-200/40 py-20 md:py-24">
      <!-- Decorative Background Pattern -->
      <div
        class="pointer-events-none absolute inset-0 opacity-10 mix-blend-luminosity dark:mix-blend-overlay"
      >
        <Image
          src={teamBg}
          alt=""
          aria-hidden="true"
          class="h-full w-full object-cover object-center"
        />
      </div>

      <div class="relative z-10 container mx-auto px-6">
        <div class="mx-auto mb-16 max-w-3xl space-y-4 text-center">
          <div
            class="text-xs font-bold tracking-widest text-primary uppercase md:text-sm"
          >
            Sector Headwinds
          </div>
          <h2
            class="text-3xl font-extrabold tracking-tight text-base-content md:text-4xl"
          >
            Key Industry Challenges We Resolve
          </h2>
          <p class="text-base leading-relaxed text-base-content/75 md:text-lg">
            Modern enterprise markets demand high compliance, speed, and resilient
            systems. We actively bridge technical gaps to remove friction from your
            operations.
          </p>
        </div>

        <!-- Challenges Cards Grid -->
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          {
            industry.challenges.map((challenge, index) => (
              <div class="group relative flex flex-col justify-between rounded-4xl border border-base-content/10 bg-base-100 p-8 transition-all duration-300 hover:border-primary/20 hover:shadow-[0_8px_30px_rgb(0,0,0,0.04)]">
                <div>
                  {/* Custom Dynamic Index Bubble */}
                  <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border border-challenge-accent/20 bg-challenge-accent/10 text-lg font-bold text-challenge-accent">
                    <CircleAlert class="h-6 w-6 shrink-0" />
                  </div>
                  <h3 class="mb-3 text-xl font-bold text-base-content transition-colors duration-300 group-hover:text-primary">
                    {challenge.title}
                  </h3>
                  <p class="text-sm leading-relaxed text-base-content/70 md:text-base">
                    {challenge.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Section 3: Core Capabilities & Solutions -->
    <section id="capabilities" class="relative scroll-mt-20 bg-base-100 py-20 md:py-28">
      <div class="container mx-auto px-6">
        <div class="mx-auto mb-16 max-w-3xl space-y-4 text-center">
          <div
            class="text-xs font-bold tracking-widest text-primary uppercase md:text-sm"
          >
            Core Competencies
          </div>
          <h2
            class="text-3xl font-extrabold tracking-tight text-base-content md:text-4xl"
          >
            Our Solutions & Capabilities
          </h2>
          <p class="text-base leading-relaxed text-base-content/70 md:text-lg">
            We deliver end-to-end consulting, precision engineering, and comprehensive
            lifecycle support.
          </p>
        </div>

        <!-- Capabilities Detailed Grid -->
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
          {
            industry.capabilities.map((capability) => (
              <div class="group flex flex-col justify-between rounded-[2.5rem] border border-base-content/10 bg-base-100 p-8 transition-all duration-500 hover:border-primary/30 hover:shadow-[0_12px_40px_rgb(0,0,0,0.06)] md:p-10">
                <div>
                  <h3 class="mb-4 text-2xl font-bold tracking-tight text-base-content transition-colors duration-300 group-hover:text-primary">
                    {capability.title}
                  </h3>
                  <p class="mb-8 text-sm leading-relaxed text-base-content/75 md:text-base">
                    {capability.description}
                  </p>
                </div>

                {/* Bullets List */}
                <div class="mt-auto border-t border-base-content/10 pt-6">
                  <ul class="space-y-4">
                    {capability.bulletPoints.map((bullet) => (
                      <li class="flex items-start gap-3 text-sm leading-relaxed text-base-content/70 md:text-base">
                        <CircleCheckBig class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Section 4: Tech Stack Highlights -->
    <section class="border-y border-base-content/10 bg-base-200/50 py-16 md:py-20">
      <div class="container mx-auto px-6">
        <div class="flex flex-col items-center justify-between gap-8 lg:flex-row">
          <div class="max-w-md space-y-2 text-center lg:text-left">
            <h3 class="text-2xl font-extrabold tracking-tight text-base-content">
              Technologies & Frameworks
            </h3>
            <p class="text-sm leading-relaxed text-base-content/70 md:text-base">
              We architect secure infrastructures matching international compliance
              standards and state-of-the-art tech platforms.
            </p>
          </div>

          <div class="flex max-w-2xl flex-wrap justify-center gap-3 lg:justify-end">
            {
              industry.techStack.map((tech) => (
                <div class="badge cursor-default rounded-full border border-primary/20 bg-primary/5 px-6 py-5 badge-lg font-bold text-primary transition-all duration-300 select-none hover:bg-primary hover:text-primary-content">
                  {tech}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Section 5: Dynamic CTA -->
    <section class="bg-base-200/50 py-20 md:py-24">
      <div class="container mx-auto px-6">
        <div
          class="relative mx-auto max-w-5xl overflow-hidden rounded-[3rem] border border-base-content/10 bg-base-200/50 p-10 text-center shadow-sm md:p-16"
        >
          <!-- Background Glow Elements -->
          <div
            class="pointer-events-none absolute -top-24 -left-24 h-72 w-72 rounded-full bg-primary/5 blur-3xl"
          >
          </div>
          <div
            class="pointer-events-none absolute -right-24 -bottom-24 h-72 w-72 rounded-full bg-primary/10 blur-3xl"
          >
          </div>

          <div class="relative z-10 mx-auto max-w-2xl space-y-6">
            <h2
              class="text-3xl leading-tight font-extrabold tracking-tight text-base-content md:text-4xl"
            >
              Accelerate Your {industry.title} Transformation
            </h2>
            <p class="text-base leading-relaxed text-base-content/75 md:text-lg">
              Partner with HTIS to architect resilient systems, optimize complex
              operations, and implement secure technology systems tailored specifically
              for your organization.
            </p>
            <div class="pt-4">
              <a
                href="/#contact"
                class="group btn inline-flex items-center gap-2 rounded-full px-8 text-base font-bold shadow-lg transition-all duration-300 btn-primary hover:shadow-primary/30"
              >
                Partner with us
                <ArrowRight
                  class="h-5 w-5 transition-transform group-hover:translate-x-1"
                />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer block -->
    <div class="bg-base-200/50">
      <div class="pt-8 md:pt-16">
        <Contact />
        <Footer overlap={true} />
      </div>
    </div>
  </div>
</Layout>
