---
import Layout from '~/layouts/Layout.astro';
import Navbar from '~/components/Navbar.astro';
import Hero from '~/components/Hero.astro';
import Services from '~/components/Services.astro';
import Journey from '~/components/Journey.svelte';
import Footprint from '~/components/Footprint.astro';
import Articles from '~/components/Articles.astro';
import Contact from '~/components/Contact.astro';
import Footer from '~/components/Footer.astro';
import Team from '~/components/Team.svelte';
import Clients from '~/components/Clients.astro';
import Testimonials from '~/components/Testimonials.astro';
import { home } from '~/data/cms';
---

<Layout>
  <div class="relative w-full overflow-hidden">
    <Navbar />
    <Hero />
    <Services services={home.services} />
    <div class="bg-linear-to-b from-transparent to-base-200/50">
      <Journey
        milestones={home.journey.milestones}
        titlePrefix={home.journey.titlePrefix}
        titleHighlight={home.journey.titleHighlight}
        subtitle={home.journey.subtitle}
        client:visible
      />
      <Team
        team={home.team.members}
        bgImageSrc={home.team.backgroundImageSrc}
        meetTeamImageSrc={home.team.meetTeamImageSrc}
        heading={home.team.heading}
        description={home.team.description}
        ctaTitle={home.team.ctaTitle}
        ctaLabel={home.team.ctaLabel}
        ctaUrl={home.team.ctaUrl}
        client:visible
      />
      <Footprint />
      <Clients />
      <Testimonials />
    </div>
    <div class="bg-base-200/50">
      <Articles />
      <div class="pt-16 md:pt-24">
        <Contact />
        <Footer overlap={true} />
      </div>
    </div>
  </div>
</Layout>
