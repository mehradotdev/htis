---
import { Image } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Navbar from '~/components/Navbar.astro';
import Footer from '~/components/Footer.astro';
import { CircleCheck } from '@lucide/astro';

import heroBg from '~/assets/about-hero-bg.png';
import missionImg from '~/assets/about-mission.png';
import lifeImg from '~/assets/about-life-at-htis.png';
import lifeBg from '~/assets/about-life-at-htis-bg.png';
import principlesImg from '~/assets/about-principles.png';
---

<Layout title="About Us - HTIS">
  <div class="relative w-full overflow-clip">
    <Navbar />

    <!-- Section 1: Hero Section -->
    <section class="relative pt-32 pb-20 w-full overflow-hidden bg-base-200/50 min-h-[420px] flex items-center">
      <!-- Background with dot-grid pattern and theme-aware filter -->
      <div class="absolute inset-0 z-0 opacity-90">
        <Image
          src={heroBg}
          alt=""
          aria-hidden="true"
          class="h-full w-full object-cover object-center"
          style="filter: var(--filter-invert-dark)"
        />
      </div>
      <!-- Radial overlay to focus attention and blend seamlessly -->
      <div class="absolute inset-0 z-0 bg-radial from-transparent via-base-100/35 to-base-100"></div>

      <!-- Hero Content -->
      <div class="relative z-10 w-full max-w-7xl mx-auto px-6 py-16 text-center">
        <h1 class="mb-6 text-4xl leading-tight font-extrabold text-base-content md:text-5xl lg:text-[56px] tracking-tight">
          The People and Expertise <span class="text-primary">Behind HTIS</span>
        </h1>
        <p class="mb-10 text-lg md:text-xl font-medium text-base-content/85 max-w-2xl mx-auto leading-relaxed">
          Building dependable infrastructure solutions through engineering innovation, deep-rooted experience, and long-term partnerships.
        </p>
        <div>
          <a href="#contact" class="btn btn-primary rounded-full px-10 text-base font-semibold shadow-lg hover:shadow-primary/30 transition-all duration-300">
            Contact Us
          </a>
        </div>
      </div>
    </section>

    <!-- Section 2: Mission, Vision, and Values -->
    <section class="py-16 md:py-24 bg-base-100">
      <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
          
          <!-- Left Column: Layered Premium Cards -->
          <div class="lg:col-span-7 space-y-4">
            <!-- Our Vision Card -->
            <div class="group rounded-2xl border border-base-200/60 bg-base-100 p-5 md:p-6 shadow-xs hover:shadow-md hover:border-primary/20 transition-all duration-300">
              <h3 class="text-lg font-bold text-base-content mb-1 transition-colors">
                Our Vision
              </h3>
              <p class="text-base-content/75 leading-relaxed text-sm md:text-base">
                To shape the future of global connectivity and digital infrastructure by delivering seamless, next-generation enterprise solutions that empower businesses to scale sustainably.
              </p>
            </div>

            <!-- Our Mission Card -->
            <div class="group rounded-2xl border border-base-200/60 bg-base-100 p-5 md:p-6 shadow-xs hover:shadow-md hover:border-primary/20 transition-all duration-300">
              <h3 class="text-lg font-bold text-base-content mb-1 transition-colors">
                Our Mission
              </h3>
              <p class="text-base-content/75 leading-relaxed text-sm md:text-base">
                To deliver dependable, high-performance IT infrastructure and telecom services through continuous engineering innovation, operational excellence, and lasting client partnerships.
              </p>
            </div>

            <!-- Our Value Card -->
            <div class="group rounded-2xl border border-base-200/60 bg-base-100 p-5 md:p-6 shadow-xs hover:shadow-md hover:border-primary/20 transition-all duration-300">
              <h3 class="text-lg font-bold text-base-content mb-1 transition-colors">
                Our Value
              </h3>
              <p class="text-base-content/75 leading-relaxed text-sm md:text-base">
                We are anchored in reliability, professional integrity, and an unyielding commitment to engineering excellence. We believe in collaborative success and creating practical impact.
              </p>
            </div>
          </div>

          <!-- Right Column: Visual Element -->
          <div class="lg:col-span-5 relative flex justify-center">
            <div class="relative group w-full max-w-md lg:max-w-none">
              <!-- Aesthetic outline wrapper -->
              <div class="absolute -inset-4 rounded-xl bg-gradient-to-tr from-primary/10 to-transparent blur-md opacity-75"></div>
              <Image
                src={missionImg}
                alt="Writing vision on boards"
                class="relative z-10 w-full object-cover rounded-xl shadow-xl border border-base-200 transition-all duration-500 hover:scale-[1.01]"
              />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Section 3: Life at HTIS -->
    <section class="py-16 md:py-24 bg-base-200/30 relative overflow-hidden">
      <!-- Background elements for visual complexity -->
      <div class="absolute inset-0 z-0 opacity-90">
        <Image
          src={lifeBg}
          alt=""
          aria-hidden="true"
          class="w-full h-full object-cover"
          style="filter: var(--filter-invert-dark)"
        />
      </div>
      <div class="absolute inset-0 z-0 bg-linear-to-r from-base-100/90 via-base-100/50 to-transparent"></div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
          
          <!-- Left Column: Collage -->
          <div class="lg:col-span-6 flex justify-center">
            <div class="relative w-full max-w-md lg:max-w-lg transition-transform duration-500 hover:scale-[1.01]">
              <Image
                src={lifeImg}
                alt="Collage of team and office life at HTIS"
                class="w-full object-contain filter drop-shadow-2xl"
              />
            </div>
          </div>

          <!-- Right Column: Description -->
          <div class="lg:col-span-6 space-y-6">
            <h2 class="text-3xl md:text-4xl font-extrabold text-base-content tracking-tight">
              Life at <span class="text-primary">HTIS</span>
            </h2>
            <div class="h-1.5 w-20 bg-primary rounded-full"></div>
            <p class="text-base md:text-lg text-base-content/80 leading-relaxed pt-2">
              At HTIS, our culture thrives on collaboration, continuous growth, and an inclusive community where every voice is valued. We foster an environment of professional excellence combined with creative freedom.
            </p>
            <p class="text-base md:text-lg text-base-content/80 leading-relaxed">
              Whether building next-generation telecom networks or integrating complex enterprise IT infrastructures, our teams work together to solve meaningful challenges. We invite you to bring your passion and join our growing team.
            </p>
            <div class="pt-4">
              <a href="/jobs" class="btn btn-primary rounded-full px-8 text-base font-semibold shadow-md hover:shadow-primary/20 transition-all duration-300">
                See Open Roles
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Section 4: Principles Section -->
    <section class="py-16 md:py-24 bg-base-200/50">
      <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">
          
          <!-- Left Column: Content and List -->
          <div class="lg:col-span-7 space-y-8">
            <div>
              <h2 class="text-3xl md:text-4xl font-extrabold text-base-content tracking-tight">
                Principles that shape <span class="text-primary">Every Solution</span>
              </h2>
              <p class="mt-4 text-base md:text-lg text-base-content/75 leading-relaxed">
                At HTIS, our work is guided by a commitment to reliability, collaboration, and continuous improvement — helping us deliver solutions organizations can depend on.
              </p>
            </div>

            <!-- Custom Checklist Stack (Single Column as in Figma) -->
            <div class="flex flex-col gap-3 max-w-lg">
              <div class="flex items-center gap-3.5 rounded-xl border border-base-200/40 p-3 hover:border-primary/20 hover:bg-primary/5 transition-all duration-300 group">
                <CircleCheck class="h-5 w-5 text-primary shrink-0 transition-transform duration-300 group-hover:scale-110" />
                <span class="font-semibold text-base text-base-content/90 group-hover:text-primary transition-colors">Reliability Across Every Deployment</span>
              </div>
              <div class="flex items-center gap-3.5 rounded-xl border border-base-200/40 p-3 hover:border-primary/20 hover:bg-primary/5 transition-all duration-300 group">
                <CircleCheck class="h-5 w-5 text-primary shrink-0 transition-transform duration-300 group-hover:scale-110" />
                <span class="font-semibold text-base text-base-content/90 group-hover:text-primary transition-colors">Accountability in Every Partnership</span>
              </div>
              <div class="flex items-center gap-3.5 rounded-xl border border-base-200/40 p-3 hover:border-primary/20 hover:bg-primary/5 transition-all duration-300 group">
                <CircleCheck class="h-5 w-5 text-primary shrink-0 transition-transform duration-300 group-hover:scale-110" />
                <span class="font-semibold text-base text-base-content/90 group-hover:text-primary transition-colors">Innovation with Practical Impact</span>
              </div>
              <div class="flex items-center gap-3.5 rounded-xl border border-base-200/40 p-3 hover:border-primary/20 hover:bg-primary/5 transition-all duration-300 group">
                <CircleCheck class="h-5 w-5 text-primary shrink-0 transition-transform duration-300 group-hover:scale-110" />
                <span class="font-semibold text-base text-base-content/90 group-hover:text-primary transition-colors">Collaboration That Drives Results</span>
              </div>
              <div class="flex items-center gap-3.5 rounded-xl border border-base-200/40 p-3 hover:border-primary/20 hover:bg-primary/5 transition-all duration-300 group">
                <CircleCheck class="h-5 w-5 text-primary shrink-0 transition-transform duration-300 group-hover:scale-110" />
                <span class="font-semibold text-base text-base-content/90 group-hover:text-primary transition-colors">Commitment to Long-Term Growth</span>
              </div>
            </div>
          </div>

          <!-- Right Column: Visual -->
          <div class="lg:col-span-5 flex justify-center">
            <div class="relative w-full max-w-md lg:max-w-none transition-transform duration-500 hover:scale-[1.01]">
              <!-- Aesthetic subtle outline backdrop -->
              <div class="absolute -inset-4 rounded-[2.5rem] bg-linear-to-bl from-primary/10 to-transparent blur-md opacity-75"></div>
              <Image
                src={principlesImg}
                alt="Telecom tower and architectural technology elements"
                class="relative z-10 w-full object-contain rounded-[2rem]"
              />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Footer block -->
    <div class="bg-base-200/50">
      <Footer />
    </div>
  </div>
</Layout>
