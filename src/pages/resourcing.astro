---
import { Image } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Navbar from '~/components/Navbar.astro';
import Footer from '~/components/Footer.astro';
import ResourcingCapabilities from '~/components/resourcing/ResourcingCapabilities.astro';

import heroLeftBg from '~/assets/lob-resourcing-hero-left-bg.png';
import heroRightBg1 from '~/assets/lob-resourcing-hero-right-bg-1.png';
import heroRightBg2 from '~/assets/lob-resourcing-hero-right-bg-2.png';
import heroRightBg3 from '~/assets/lob-resourcing-hero-right-bg-3.png';
import heroRightBg4 from '~/assets/lob-resourcing-hero-right-bg-4.png';
import heroRightBg5 from '~/assets/lob-resourcing-hero-right-bg-5.png';
import bgImage from '~/assets/team-member-bg.png';
import ResourcingExtraSections from '~/components/resourcing/ResourcingExtraSections.astro';
import ResourcingHeroCarousel from '~/components/resourcing/ResourcingHeroCarousel.svelte';
---

<Layout title="Resourcing - HTIS">
  <div class="relative w-full overflow-clip">
    <Navbar />

    <!-- Hero Section -->
    <section class="relative pt-32 pb-16">
      <div class="container mx-auto px-6">
        <div class="flex flex-col gap-6 lg:flex-row lg:gap-8">
          <!-- Left part -->
          <div
            class="relative flex w-full items-center overflow-hidden rounded-4xl bg-base-200 lg:w-1/2"
          >
            <div class="absolute inset-0 z-0 opacity-40">
              <Image
                src={heroLeftBg}
                alt=""
                aria-hidden="true"
                class="h-full w-full object-cover object-bottom"
                style="filter: var(--filter-invert-dark)"
              />
            </div>
            <div
              class="absolute inset-0 bg-linear-to-r from-base-200/50 to-transparent lg:hidden"
            >
            </div>
            <div class="relative z-10 w-full px-8 py-16 md:px-12 lg:px-16 lg:py-24">
              <h1
                class="mb-6 max-w-lg text-4xl leading-tight font-bold text-base-content md:text-5xl lg:text-[54px]"
              >
                Full-Spectrum Resourcing: From Field to Core
              </h1>
              <p class="mb-10 max-w-lg text-xl font-medium text-base-content/80">
                A strategic approach to deploying specialized white-collar and technical
                manpower at scale. We provide the stable human capital required for
                large-scale rollouts, ensuring full regulatory compliance and proactive
                lifecycle management
              </p>
              <a
                href="/#contact"
                class="btn rounded-lg px-12 text-xl text-primary-content shadow-lg shadow-primary/20 btn-lg btn-primary"
              >
                Contact Us
              </a>
            </div>
          </div>
          <!-- Right part -->
          <ResourcingHeroCarousel
            images={[
              heroRightBg1.src,
              heroRightBg2.src,
              heroRightBg3.src,
              heroRightBg4.src,
              heroRightBg5.src,
            ]}
            client:load
          />
        </div>
      </div>
    </section>

    <!-- Capabilities Section -->
    <section class="relative overflow-hidden bg-base-100 py-24">
      <!-- Background Image -->
      <div
        class="pointer-events-none absolute inset-0 z-0 opacity-70 dark:mix-blend-overlay"
      >
        <Image
          src={bgImage}
          alt=""
          aria-hidden="true"
          class="h-full w-full object-cover object-center"
          style="filter: var(--filter-invert-dark)"
        />
        <div
          class="absolute inset-0 bg-linear-to-b from-base-100/80 via-transparent to-base-100"
        >
        </div>
      </div>

      <div class="relative z-10 container mx-auto px-6">
        <div class="mb-10 max-w-3xl">
          <h2 class="mb-6 text-4xl font-bold text-base-content md:text-5xl">
            Our Capabilities - Strategic Human Capital Deployment
          </h2>
          <p class="text-xl font-medium text-base-content/70">
            A structured, compliance-driven framework for engineering and operational
            talent at scale.
          </p>
        </div>

        <ResourcingCapabilities />
      </div>
    </section>

    <ResourcingExtraSections />

    <div class="bg-base-200/50">
      <Footer />
    </div>
  </div>
</Layout>
