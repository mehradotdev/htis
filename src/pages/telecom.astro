---
import { Image } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Navbar from '~/components/Navbar.astro';
import Footer from '~/components/Footer.astro';
import TelecomCapabilities from '~/components/telecom/TelecomCapabilities.svelte';
import TelecomExtraSections from '~/components/telecom/TelecomExtraSections.astro';

import heroBg from '~/assets/lob-telecom-hero-bg.png';
import bgImage from '~/assets/team-member-bg.png';
import cap1 from '~/assets/lob-telecom-capability-1.png';
import cap2 from '~/assets/lob-telecom-capability-2.png';
import cap3 from '~/assets/lob-telecom-capability-3.png';
import { telecomCapabilities } from '~/data/pageDataTelecom';

const capabilitiesImages = [cap1.src, cap2.src, cap3.src];
---

<Layout title="Telecom - HTIS">
  <div class="relative w-full overflow-clip">
    <Navbar />

    <!-- Hero Section -->
    <section class="relative flex min-h-[70vh] items-center pt-24 pb-12">
      <!-- Background Image -->
      <div class="absolute inset-0 z-0">
        <Image
          src={heroBg}
          alt=""
          aria-hidden="true"
          class="h-full w-full object-cover object-right lg:object-center"
          style="filter: var(--filter-invert-dark)"
        />
        <!-- Gradients to ensure text readability -->
        <div class="absolute inset-0 bg-base-100/40 lg:bg-transparent"></div>
        <div
          class="absolute inset-0 bg-linear-to-r from-base-100/95 via-base-100/80 to-transparent lg:w-2/3"
        >
        </div>
        <div
          class="absolute inset-0 bg-linear-to-b from-transparent via-transparent to-base-100"
        >
        </div>
      </div>

      <!-- Content -->
      <div class="relative z-10 container mx-auto w-full px-6">
        <div class="max-w-2xl">
          <h1
            class="mb-6 text-4xl leading-tight font-bold text-base-content md:text-5xl lg:text-6xl"
          >
            Connecting the next billion-intelligent Network for tomorrow
          </h1>
          <p class="mb-10 text-lg text-base-content/80 md:text-xl">
            Seamlessly integrating turnkey physical infrastructure and cognitive network
            intelligence to build hyper-scale, future-ready networks.
          </p>
          <a
            href="/#contact"
            class="btn rounded-full border-none px-8 text-white shadow-lg transition-transform btn-primary hover:scale-105"
          >
            Contact us
          </a>
        </div>
      </div>
    </section>

    <!-- Capabilities Section -->
    <section class="relative overflow-hidden bg-base-100 py-24">
      <!-- Background Image -->
      <div
        class="pointer-events-none absolute inset-0 z-0 opacity-40 mix-blend-luminosity dark:mix-blend-overlay"
      >
        <Image
          src={bgImage}
          alt=""
          aria-hidden="true"
          class="h-full w-full object-cover object-center"
          style="filter: var(--filter-invert-dark)"
        />
        <div
          class="absolute inset-0 bg-linear-to-b from-base-100/80 via-transparent to-base-100"
        >
        </div>
      </div>

      <div class="relative z-10 container mx-auto px-6">
        <div class="mx-auto mb-16 max-w-3xl text-center">
          <h2 class="mb-6 text-4xl font-bold text-base-content md:text-5xl">
            Our Capabilities
          </h2>
          <p class="text-lg text-base-content/70">
            A structured approach to deploying, optimizing, and supporting telecom
            networks across every stage.
          </p>
        </div>

        <TelecomCapabilities capabilities={telecomCapabilities} images={capabilitiesImages} client:visible />
      </div>
    </section>

    <TelecomExtraSections />

    <div class="bg-base-200/50">
      <Footer />
    </div>
  </div>
</Layout>
