---
import { Image } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Navbar from '~/components/Navbar.astro';
import Footer from '~/components/Footer.astro';

import heroBg from '~/assets/industry-hero-bg.png';
import heroImg from '~/assets/industry-hero-img.png';

import {
  RadioTower,
  Landmark,
  Building2,
  Factory,
  HeartPulse,
  HardHat,
  ArrowUpRight,
} from '@lucide/astro';

const industries = [
  {
    title: 'Telcos and ISPs',
    slug: 'telcos-and-isps',
    desc: 'Empowering connectivity with next-generation network infrastructure, high-speed fiber solutions, and robust operational support to meet the growing demands of a digital world.',
    icon: RadioTower,
  },
  {
    title: 'Public Sector, Ministries & Defence',
    slug: 'public-sector-ministries-defence',
    desc: 'Delivering secure, scalable, and mission-critical IT infrastructure and communication systems tailored for government agencies, ministries, and defense organizations.',
    icon: Landmark,
  },
  {
    title: 'BFSI (Banking, Financial Services & Insurance)',
    slug: 'bfsi',
    desc: 'Driving financial digital transformation through ultra-secure data centers, seamless network integration, and high-availability infrastructure for banks and financial institutions.',
    icon: Building2,
  },
  {
    title: 'Manufacturing, Automobile & FMCG',
    slug: 'manufacturing-automobile-fmcg',
    desc: 'Accelerating Industry 4.0 adoption with smart factory connectivity, automation integrations, and resilient supply chain networking for modern production facilities.',
    icon: Factory,
  },
  {
    title: 'Healthcare & Education',
    slug: 'healthcare-education',
    desc: 'Enabling remote care, telemedicine networks, and digital classrooms through high-bandwidth connectivity and secure, compliant data management solutions.',
    icon: HeartPulse,
  },
  {
    title: 'Real Estate, Infrastructure & Smart Spaces',
    slug: 'real-estate-infrastructure-smart-spaces',
    desc: 'Building intelligent environments with integrated IoT networks, smart building automation, and future-ready IT infrastructure for commercial and residential spaces.',
    icon: HardHat,
  },
];
---

<Layout title="Industries - HTIS">
  <div class="relative w-full overflow-clip">
    <Navbar />

    <!-- Section 1: Hero Section -->
    <section
      class="relative flex min-h-[500px] w-full items-center overflow-hidden bg-base-100 pt-32 pb-20 md:min-h-[600px]"
    >
      <!-- Background -->
      <div class="absolute inset-0 z-0 opacity-100">
        <Image
          src={heroBg}
          alt=""
          aria-hidden="true"
          class="h-full w-full object-cover object-center"
          style="filter: var(--filter-invert-dark)"
        />
      </div>
      <!-- Radial overlay for text readability -->
      <!-- <div class="absolute inset-0 z-0 bg-gradient-to-r from-base-100/35 via-base-100/80 to-transparent"></div> -->

      <!-- Hero Content -->
      <div class="relative z-10 container mx-auto px-6">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
          <!-- Text Content -->
          <div class="space-y-6 text-left md:pr-10">
            <h1
              class="text-4xl leading-tight font-extrabold tracking-tight text-base-content md:text-5xl lg:text-[56px]"
            >
              Industries we <br class="hidden lg:block" /><span class="text-primary"
                >Empower</span
              >
            </h1>
            <p
              class="max-w-xl text-lg leading-relaxed font-medium text-base-content/85 md:text-xl"
            >
              We deliver tailored solutions across a wide range of industries, helping
              businesses innovate, optimize, and grow in a rapidly changing world.
            </p>
            <div class="pt-4">
              <a
                href="#contact"
                class="btn rounded-lg px-8 text-base font-semibold shadow-lg transition-all duration-300 btn-primary hover:shadow-primary/30"
              >
                Contact Us
              </a>
            </div>
          </div>

          <!-- Image -->
          <div class="relative flex justify-center lg:justify-end">
            <Image
              src={heroImg}
              alt="Industries Collage"
              class="relative z-10 w-full max-w-lg object-contain transition-transform duration-500 hover:scale-[1.02] lg:max-w-xl"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Industries Grid -->
    <section class="bg-base-200/50 py-20 md:py-28">
      <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          {
            industries.map((item) => (
              <a
                href={`/industry/${item.slug}`}
                class="group relative flex flex-col rounded-4xl border border-base-content/30 bg-base-100 p-8 transition-all duration-500 hover:border-primary/30 hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)]"
              >
                {/* Top Right Decorative Arrow */}
                <div class="btn pointer-events-none absolute top-4 right-4 flex btn-circle items-center justify-center border border-primary/30 text-primary btn-ghost transition-all duration-300 btn-sm group-hover:rotate-45 group-hover:border-primary group-hover:bg-primary group-hover:text-primary-content">
                  <ArrowUpRight class="h-4 w-4" />
                </div>

                {/* Icon + Content (centered) */}
                <div class="mt-2 flex flex-col items-center text-center">
                  <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-primary/10 text-primary transition-transform duration-500 group-hover:scale-110">
                    <item.icon class="h-10 w-10" />
                  </div>
                  <h3 class="mb-4 text-xl font-bold text-base-content transition-colors group-hover:text-primary md:text-2xl">
                    {item.title}
                  </h3>
                  <p class="text-sm leading-relaxed text-base-content/75 md:text-base">
                    {item.desc}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Footer block -->
    <div class="bg-base-200/50">
      <Footer />
    </div>
  </div>
</Layout>
