---
import Layout from '~/layouts/Layout.astro';
import Navbar from '~/components/Navbar.astro';
import Footer from '~/components/Footer.astro';
import JobListing from '~/components/jobs/JobListing.svelte';

const jobs = [
  { id: 'account-executive', role: 'Account Executive', department: 'Sales', location: 'Gurugram' },
  { id: 'front-end-software-developer', role: 'Front-end Software Developer', department: 'Software', location: 'Gurugram' },
  { id: 'front-end-software-developer-2', role: 'Front-end Software Developer', department: 'Software', location: 'Gurugram' },
  { id: 'front-end-software-developer-3', role: 'Front-end Software Developer', department: 'Software', location: 'Gurugram' },
  { id: 'front-end-software-developer-4', role: 'Front-end Software Developer', department: 'Software', location: 'Gurugram' },
  { id: 'front-end-software-developer-5', role: 'Front-end Software Developer', department: 'Software', location: 'Gurugram' },
  { id: 'front-end-software-developer-6', role: 'Front-end Software Developer', department: 'Software', location: 'Gurugram' },
  { id: 'backend-engineer', role: 'Backend Engineer', department: 'Software', location: 'Mumbai' },
  { id: 'product-manager', role: 'Product Manager', department: 'Product', location: 'Mumbai' },
  { id: 'ux-designer', role: 'UX Designer', department: 'Design', location: 'Mumbai' },
];
---

<Layout>
  <div class="relative w-full min-h-screen bg-base-200/30 flex flex-col pt-24 pb-0">
    <Navbar />
    
    <main class="flex-grow w-full max-w-5xl mx-auto px-4 md:px-6 py-12 md:py-20 z-10">
      <h1 class="text-4xl md:text-5xl font-bold text-primary mb-12">
        Find your next<br/>Opportunity
      </h1>
      
      <JobListing jobs={jobs} client:load />
    </main>

    <div class="mt-auto">
      <Footer />
    </div>
  </div>
</Layout>
