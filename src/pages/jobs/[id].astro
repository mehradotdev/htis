---
import Layout from '~/layouts/Layout.astro';
import Navbar from '~/components/Navbar.astro';
import Footer from '~/components/Footer.astro';
import { getDummyJobDetails } from '~/data/jobs';
import JobApplyModal from '~/components/jobs/JobApplyModal.svelte';

export async function getStaticPaths() {
  // Handcrafted fallbacks for IDs 5, 4, 1 in case API fetch fails
  const fallbackNumericPaths = [
    { id: '5', title: '.Net Technical Lead', location: 'CHANDIGARH', skills: 'Programming & Development', minExperience: 5, maxExperience: 15 },
    { id: '4', title: 'Accountant', location: 'CHANDIGARH', skills: 'Additional Specialized Skills', minExperience: 2, maxExperience: 10 },
    { id: '1', title: 'Software Developer', location: 'BILASPUR', skills: 'Programming & Development', minExperience: 2, maxExperience: 5 }
  ].map((item) => ({
    params: { id: item.id },
    props: {
      apiJob: {
        jobId: item.id,
        title: item.title,
        location: item.location,
        skills: item.skills,
        minExperience: item.minExperience,
        maxExperience: item.maxExperience,
        description: 'Testing',
      },
    },
  }));

  try {
    const response = await fetch('https://wfmsv2api.htistelecom.in/api/Hiring/JobList');
    const result = await response.json();
    const jobsList = result.data || [];
    
    // Map API jobs to static paths
    const apiPaths = jobsList.map((job: any) => ({
      params: { id: job.jobId.toString() },
      props: { apiJob: job },
    }));

    // Merge fallback numeric paths and API paths (deduplicate by param ID to be safe)
    const allPathsMap = new Map();
    [...fallbackNumericPaths, ...apiPaths].forEach(p => {
      allPathsMap.set(p.params.id, p);
    });
    return Array.from(allPathsMap.values());

  } catch (error) {
    console.error('Failed to fetch jobs at build time, using numeric fallbacks:', error);
    return fallbackNumericPaths;
  }
}

const { apiJob } = Astro.props;
const job = getDummyJobDetails(apiJob);
---

<Layout>
  <div class="relative flex min-h-screen w-full flex-col bg-base-200/30 pt-24 pb-0">
    <Navbar />

    <main class="z-10 mx-auto w-full max-w-5xl grow px-4 py-12 md:px-6 md:py-20">
      <h1
        class="mb-12 text-4xl font-bold text-base-content md:mb-16 md:text-5xl lg:text-6xl"
      >
        {job.role}
      </h1>

      <div class="flex flex-col gap-12 lg:flex-row lg:gap-20">
        <!-- Main Content -->
        <div class="flex-1 space-y-12 text-lg text-base-content/80">
          <section>
            <h2 class="mb-6 text-3xl font-bold text-base-content">What You'll do</h2>
            <p class="leading-relaxed whitespace-pre-wrap">{job.whatYouWillDo}</p>
          </section>

          <section>
            <h2 class="mb-6 text-3xl font-bold text-base-content">Responsibilities</h2>
            <ul class="list-disc space-y-4 pl-6 leading-relaxed marker:text-primary/50">
              {job.responsibilities.map((item) => <li>{item}</li>)}
            </ul>
          </section>

          <section>
            <h2 class="mb-6 text-3xl font-bold text-base-content">Who you are</h2>
            <p class="leading-relaxed">
              We're looking for someone who meets the minimum requirements to be
              considered for the role. If you meet these requirements, you are encouraged
              to apply. The preferred qualifications are a bonus, not a requirement.
            </p>
          </section>

          <section>
            <h2 class="mb-6 text-3xl font-bold text-base-content">
              Minimum requirements
            </h2>
            <ul class="list-disc space-y-4 pl-6 leading-relaxed marker:text-primary/50">
              {job.minimumRequirements.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        </div>

        <!-- Sidebar / Sticky Card -->
        <div class="shrink-0 lg:w-[380px]">
          <div class="sticky top-32 rounded-lg bg-base-content/10 p-8 md:p-10">
            <div class="space-y-6">
              <div class="flex items-start justify-between gap-4 text-lg font-medium">
                <span class="text-base-content/70 shrink-0">Location:</span>
                <span class="font-semibold text-base-content text-right">{job.location}</span>
              </div>

              <div class="h-px w-full bg-base-content/20"></div>

              <div class="text-center text-xl font-bold text-base-content">
                {job.experience}
              </div>

              <div class="h-px w-full bg-base-content/20"></div>

              <div class="flex items-start justify-between gap-4 text-lg font-medium">
                <span class="text-base-content/70 shrink-0">Team:</span>
                <span class="font-semibold text-base-content text-right">{job.department}</span>
              </div>

              <div class="pt-4">
                <JobApplyModal jobId={job.id} jobTitle={job.role} client:load />
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <div class="mt-auto">
      <Footer />
    </div>
  </div>
</Layout>
