---
import Layout from '~/layouts/Layout.astro';
import Navbar from '~/components/Navbar.astro';
import Footer from '~/components/Footer.astro';
import SystemIntegrationHero from '~/components/system-integration/SystemIntegrationHero.astro';
import PartnerEcosystem from '~/components/system-integration/PartnerEcosystem.svelte';

import { Image } from 'astro:assets';
import bgImage from '~/assets/team-member-bg.png';
import centerImage from '~/assets/lob-system-tech-pillars.png';
import { Database, Network, Users, Code } from '@lucide/astro';
import TelecomMetrics from '~/components/telecom/TelecomMetrics.svelte';

import logoDell from '~/assets/logo-dell.png';
import logoHP from '~/assets/logo-HP.png';
import logoCisco from '~/assets/logo-Cisco.webp';
import logoAruba from '~/assets/logo-Aruba.png';
import logoJuniper from '~/assets/logo-Juniper-Networks.png';
import logoRuckus from '~/assets/logo-ruckus-networks.png';
import logoFortinet from '~/assets/logo-Fortinet.png';
import logoCheckPoint from '~/assets/logo-CheckPoint.png';
import logoSonicwall from '~/assets/logo-Sonicwall.png';
import logoSchneider from '~/assets/logo-Schneider-Electric.png';
import logoVertiv from '~/assets/logo-Vertiv.png';
import logoEaton from '~/assets/logo-Eaton.jpg';
import logoHikvision from '~/assets/logo-Hikwision.png';
import logoSamsung from '~/assets/logo-Samsung.png';

const pillars = [
  {
    title: 'Converged Infrastructure & Data Centre Stack',
    description:
      'High-availability compute and storage architectures from the core to the edge.',
  },
  {
    title: 'Converged Infrastructure & Data Centre Stack',
    description:
      'High-availability compute and storage architectures from the core to the edge.',
  },
  {
    title: 'Converged Infrastructure & Data Centre Stack',
    description:
      'High-availability compute and storage architectures from the core to the edge.',
  },
  {
    title: 'Converged Infrastructure & Data Centre Stack',
    description:
      'High-availability compute and storage architectures from the core to the edge.',
  },
  {
    title: 'Converged Infrastructure & Data Centre Stack',
    description:
      'High-availability compute and storage architectures from the core to the edge.',
  },
  {
    title: 'Converged Infrastructure & Data Centre Stack',
    description:
      'High-availability compute and storage architectures from the core to the edge.',
  },
  {
    title: 'Converged Infrastructure & Data Centre Stack',
    description:
      'High-availability compute and storage architectures from the core to the edge.',
  },
];

const ecosystemTabs = [
  {
    title: "Compute & Mobility",
    subtitle: "Laptops, Servers, High-End Workstations",
    partners: [
      { name: "Dell", logoSrc: logoDell.src },
      { name: "HP", logoSrc: logoHP.src },
      { name: "Lenovo" },
      { name: "MSi" },
      { name: "Apple (Enterprise)" }
    ]
  },
  {
    title: "Networking & Fabric",
    subtitle: "Active Switches, Routers, Wireless, SD-WAN",
    partners: [
      { name: "Cisco", logoSrc: logoCisco.src },
      { name: "Aruba (HPE)", logoSrc: logoAruba.src },
      { name: "Juniper Networks", logoSrc: logoJuniper.src },
      { name: "Ruckus", logoSrc: logoRuckus.src }
    ]
  },
  {
    title: "Cybersecurity",
    subtitle: "Firewalls, EDR/XDR, Identity Management",
    partners: [
      { name: "Palo Alto" },
      { name: "Fortinet", logoSrc: logoFortinet.src },
      { name: "Check Point", logoSrc: logoCheckPoint.src },
      { name: "SonicWall", logoSrc: logoSonicwall.src },
      { name: "Sophos" }
    ]
  },
  {
    title: "Cloud & Virtualization",
    subtitle: "Hybrid Cloud, VDI, Hyperconverged (HCI)",
    partners: [
      { name: "AWS" },
      { name: "Microsoft Azure" },
      { name: "VMware" },
      { name: "Nutanix" }
    ]
  },
  {
    title: "Storage & Backup",
    subtitle: "Enterprise Storage, Data Protection",
    partners: [
      { name: "NetApp" },
      { name: "Pure Storage" },
      { name: "Veeam" },
      { name: "Commvault" }
    ]
  },
  {
    title: "Infra & Power",
    subtitle: "Data Centre Racks, UPS, Precision Cooling",
    partners: [
      { name: "Schneider Electric", logoSrc: logoSchneider.src },
      { name: "APC" },
      { name: "Vertiv", logoSrc: logoVertiv.src },
      { name: "Eaton", logoSrc: logoEaton.src }
    ]
  },
  {
    title: "Surveillance & AV",
    subtitle: "Physical Security, LED Walls, VC",
    partners: [
      { name: "Hikvision", logoSrc: logoHikvision.src },
      { name: "Axis" },
      { name: "Milestone" },
      { name: "Samsung", logoSrc: logoSamsung.src },
      { name: "Crestron" }
    ]
  }
];
---

<Layout title="System Integration & IT Infrastructure - HTIS">
  <div class="relative w-full overflow-clip">
    <Navbar />

    <SystemIntegrationHero />

    <!-- Strategic Technical Pillars Section -->
    <section class="relative overflow-hidden bg-base-100 py-24">
      <!-- Background Image -->
      <div
        class="pointer-events-none absolute inset-0 z-0 opacity-70 dark:mix-blend-overlay"
      >
        <Image
          src={bgImage}
          alt=""
          aria-hidden="true"
          class="h-full w-full object-cover object-center"
          style="filter: var(--filter-invert-dark)"
        />
        <div
          class="absolute inset-0 bg-linear-to-b from-base-100/80 via-transparent to-base-100"
        >
        </div>
      </div>

      <div class="relative z-10 container mx-auto px-6">
        <div class="mb-16">
          <h2 class="text-4xl font-bold text-base-content md:text-5xl">
            Strategic Technical Pillars
          </h2>
        </div>

        <div
          class="flex flex-col items-center justify-between gap-8 lg:flex-row lg:items-stretch"
        >
          <!-- Left Column -->
          <div class="flex w-full flex-col justify-center gap-6 lg:w-1/3">
            {
              pillars.slice(0, 3).map((pillar) => (
                <div class="flex flex-row items-start gap-4 rounded-2xl border border-base-content/20 bg-base-content/2 p-6 shadow-sm backdrop-blur-md transition-colors hover:bg-base-300/60">
                  <div class="mt-1 text-primary">
                    <Database class="h-8 w-8" stroke-width={1.5} />
                  </div>
                  <div>
                    <h3 class="mb-2 text-sm font-semibold text-primary">
                      {pillar.title}
                    </h3>
                    <p class="text-sm font-medium text-base-content/70">
                      {pillar.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>

          <!-- Center Column -->
          <div class="flex w-full flex-col items-center justify-center gap-8 lg:w-1/3">
            <div class="flex w-full justify-center">
              <Image
                src={centerImage}
                alt="Strategic Pillars"
                class="max-h-[500px] w-auto object-contain drop-shadow-xl"
                style="-webkit-mask-image: radial-gradient(ellipse at 50% 50%, black 20%, transparent 60%); mask-image: radial-gradient(ellipse at 50% 50%, black 20%, transparent 60%);"
              />
            </div>
            {
              pillars.slice(6, 7).map((pillar) => (
                <div class="flex w-full flex-row items-start gap-4 rounded-2xl border border-base-content/20 bg-base-content/2 p-6 shadow-sm backdrop-blur-md transition-colors hover:bg-base-300/60">
                  <div class="mt-1 text-primary">
                    <Database class="h-8 w-8" stroke-width={1.5} />
                  </div>
                  <div>
                    <h3 class="mb-2 text-sm font-semibold text-primary">
                      {pillar.title}
                    </h3>
                    <p class="text-sm font-medium text-base-content/70">
                      {pillar.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>

          <!-- Right Column -->
          <div class="flex w-full flex-col justify-center gap-6 lg:w-1/3">
            {
              pillars.slice(3, 6).map((pillar) => (
                <div class="flex flex-row items-start gap-4 rounded-2xl border border-base-content/20 bg-base-content/2 p-6 shadow-sm backdrop-blur-md transition-colors hover:bg-base-300/60">
                  <div class="mt-1 text-primary">
                    <Database class="h-8 w-8" stroke-width={1.5} />
                  </div>
                  <div>
                    <h3 class="mb-2 text-sm font-semibold text-primary">
                      {pillar.title}
                    </h3>
                    <p class="text-sm font-medium text-base-content/70">
                      {pillar.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- The HTIS Partner Ecosystem Section -->
    <section class="relative bg-base-100 py-16 md:py-24">
      <div class="container mx-auto px-6">
        <PartnerEcosystem tabs={ecosystemTabs} client:visible />
      </div>
    </section>

    <!-- Built to Execute. Scaled to Deliver. Section (from Telecom) -->
    <section class="relative bg-base-200/50 py-24">
      <div class="container mx-auto px-6">
        <!-- Stats -->
        <TelecomMetrics client:visible />

        <!-- Pillars -->
        <div
          class="mt-16 grid grid-cols-1 border-y-2 border-base-content/20 py-12 md:grid-cols-3 lg:mt-20 lg:py-16"
        >
          <div class="flex flex-col gap-4 pb-12 md:pr-10 md:pb-0 lg:pr-14">
            <div
              class="mb-2 flex h-14 w-14 items-center justify-center rounded-2xl border border-base-content/5 bg-base-100 text-primary shadow-sm"
            >
              <Network class="h-8 w-8" />
            </div>
            <h3 class="text-xl font-bold">
              Converged IT Infrastructure & Systems Integration
            </h3>
            <p class="text-lg text-base-content/70">
              Architecting the high-availability IT fabrics that power mission-critical
              network operations. We provide the end-to-end IT backbone for modern Telcos,
              ranging from Tier III/IV Data Center engineering and virtualization to
              software-defined networking (SDN) and high-density compute environments.
            </p>
          </div>
          <div
            class="flex flex-col gap-4 border-y-2 border-base-content/20 py-12 md:border-x-2 md:border-y-0 md:px-10 md:py-0 lg:px-14"
          >
            <div
              class="mb-2 flex h-14 w-14 items-center justify-center rounded-2xl border border-base-content/5 bg-base-100 text-primary shadow-sm"
            >
              <Users class="h-8 w-8" />
            </div>
            <h3 class="text-xl font-bold">
              Specialized Technical Resourcing & Deployment
            </h3>
            <p class="text-lg text-base-content/70">
              Scalable L1–L6 talent solutions engineered for complex, multi-region telecom
              rollouts. We bridge the technical skill gap by deploying a domain-expert
              workforce. From high-niche technical architects (L6) to scalable field
              engineering units (L1), we provide the human capital required for
              operational excellence.
            </p>
          </div>
          <div class="flex flex-col gap-4 pt-12 md:pt-0 md:pl-10 lg:pl-14">
            <div
              class="mb-2 flex h-14 w-14 items-center justify-center rounded-2xl border border-base-content/5 bg-base-100 text-primary shadow-sm"
            >
              <Code class="h-8 w-8" />
            </div>
            <h3 class="text-xl font-bold">
              Enterprise Software Engineering & On-Demand Solutions
            </h3>
            <p class="text-lg text-base-content/70">
              Bespoke digital assets and SaaS platforms tailored for government and
              corporate scale. We build the intelligence that drives connectivity.
              Specializing in on-demand software development, we deliver secure,
              high-compliance digital assets—including our proprietary ERP
              systems—designed for the most demanding regulatory environments.
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="bg-base-200/50">
      <Footer />
    </div>
  </div>
</Layout>
