---
import { Image } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Navbar from '~/components/Navbar.astro';
import Footer from '~/components/Footer.astro';
import CaseStudyList from '~/components/case-studies/CaseStudyList.svelte';

import caseStudyImg from '~/assets/case-study-1.png';
---

<Layout title="Case Studies - HTIS">
  <div class="relative w-full overflow-clip bg-base-100">
    <Navbar />

    <!-- Header Section -->
    <section class="pt-32 pb-8 w-full max-w-7xl mx-auto px-6">
      <div class="mb-4">
        <h1 class="text-4xl md:text-[2.75rem] font-extrabold text-base-content tracking-tight mb-2">
          Case Studies
        </h1>
        <p class="text-lg md:text-xl font-medium text-base-content/50">
          Real-World Solutions. Proven outcome
        </p>
      </div>
    </section>

    <!-- Main Content Section -->
    <section class="pb-24 w-full max-w-7xl mx-auto px-6">
      <CaseStudyList imgSrc={caseStudyImg.src} client:load />
    </section>

    <!-- Footer block -->
    <div class="bg-base-200/50 mt-auto">
      <Footer />
    </div>
  </div>
</Layout>
