---
import { Image } from 'astro:assets';
import htisLogo from '~/assets/htis-logo.png';
import TwitterIcon from './icons/TwitterIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import LinkedInIcon from './icons/LinkedInIcon.astro';
import PhoneIcon from './icons/PhoneIcon.astro';
import EnvelopeIcon from './icons/EnvelopeIcon.astro';

interface Props {
  overlap?: boolean;
}

const { overlap = false } = Astro.props;
---

<div class={overlap ? '' : 'pt-12'}>
  <footer
    class={`relative z-10 rounded-t-3xl md:rounded-t-[4rem] bg-base-100 px-6 pb-8 md:px-12 border-t border-base-content/5 shadow-[0_-15px_30px_-5px_rgba(0,0,0,0.06)] dark:shadow-[0_-20px_40px_-5px_rgba(0,0,0,0.4)] transition-all duration-300 ${
      overlap ? '-mt-20 pt-32 md:-mt-32 md:pt-48' : 'pt-16'
    }`}
  >
    <div class="mx-auto max-w-7xl">
      <div
        class="grid grid-cols-1 gap-8 md:grid-cols-6 lg:flex lg:justify-between lg:gap-12 pb-10 text-base-content/80"
      >
        <!-- Logo and Description -->
        <aside class="col-span-1 md:col-span-6 lg:max-w-sm space-y-4">
          <Image src={htisLogo} alt="HTIS Logo" width={120} class="object-contain" />
          <p class="mt-4 text-[15px] leading-relaxed text-base-content/60 max-w-sm">
            HTIS is a thriving community where innovators, professionals, and enthusiasts
            come together to share knowledge, collaborate, and grow.
          </p>
        </aside>

        <!-- Services Links -->
        <nav class="col-span-1 md:col-span-3 lg:w-auto">
          <h6 class="mb-3 text-[17px] font-semibold text-base-content">
            Services
          </h6>
          <a href="/telecom" class="mb-1.5 block text-[15px] text-base-content/65 hover:text-primary transition-all duration-200 hover:translate-x-1">Telecom</a>
          <a href="/system-integration" class="mb-1.5 block text-[15px] text-base-content/65 hover:text-primary transition-all duration-200 hover:translate-x-1">System Integration</a>
          <a href="/software" class="mb-1.5 block text-[15px] text-base-content/65 hover:text-primary transition-all duration-200 hover:translate-x-1">Software Development</a>
          <a href="/resourcing" class="mb-1.5 block text-[15px] text-base-content/65 hover:text-primary transition-all duration-200 hover:translate-x-1">Resource Management</a>
        </nav>

        <!-- Company Links -->
        <nav class="col-span-1 md:col-span-3 lg:w-auto">
          <h6 class="mb-3 text-[17px] font-semibold text-base-content">
            Company
          </h6>
          <a href="/about" class="mb-1.5 block text-[15px] text-base-content/65 hover:text-primary transition-all duration-200 hover:translate-x-1">About us</a>
          <a href="#" class="mb-1.5 block text-[15px] text-base-content/65 hover:text-primary transition-all duration-200 hover:translate-x-1">Services</a>
          <a href="#" class="mb-1.5 block text-[15px] text-base-content/65 hover:text-primary transition-all duration-200 hover:translate-x-1">Community</a>
          <a href="#" class="mb-1.5 block text-[15px] text-base-content/65 hover:text-primary transition-all duration-200 hover:translate-x-1">Testimonial</a>
        </nav>

        <!-- Social Links -->
        <nav class="col-span-1 md:col-span-3 lg:w-auto">
          <h6 class="mb-3 text-[17px] font-semibold text-base-content">
            Socials
          </h6>
          <a
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="mb-2 flex items-center gap-2 text-[15px] text-base-content/65 hover:text-primary transition-all duration-200 hover:translate-x-1"
          >
            <TwitterIcon class="h-4 w-4" />
            <span>Twitter</span>
          </a>
          <a
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="mb-2 flex items-center gap-2 text-[15px] text-base-content/65 hover:text-primary transition-all duration-200 hover:translate-x-1"
          >
            <InstagramIcon class="h-4 w-4" />
            <span>Instagram</span>
          </a>
          <a
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="mb-2 flex items-center gap-2 text-[15px] text-base-content/65 hover:text-primary transition-all duration-200 hover:translate-x-1"
          >
            <LinkedInIcon class="h-4 w-4" />
            <span>LinkedIn</span>
          </a>
        </nav>

        <!-- Contact Links -->
        <nav class="col-span-1 md:col-span-3 lg:w-auto">
          <h6 class="mb-3 text-[17px] font-semibold text-base-content">
            Contact
          </h6>
          <div class="mb-2 flex items-center gap-2 text-[15px] text-base-content/65">
            <PhoneIcon class="h-4 w-4 text-primary" />
            <span>+123 456 7890</span>
          </div>
          <div class="flex items-center gap-2 text-[15px] text-base-content/65">
            <EnvelopeIcon class="h-4 w-4 text-primary" />
            <span>support@htis.com</span>
          </div>
        </nav>
      </div>

      <!-- Bottom Bar -->
      <div
        class="flex flex-col items-center justify-between border-t border-base-200 pt-6 pb-2 text-sm text-base-content/60 md:flex-row gap-4"
      >
        <p>© 2026. All rights reserved.</p>

        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 md:justify-end">
          <a href="/privacy" class="cursor-pointer hover:text-primary transition-colors duration-200">Privacy Policy</a>
          <a href="#" class="cursor-pointer hover:text-primary transition-colors duration-200">Terms of Use</a>
          <a href="#" class="cursor-pointer hover:text-primary transition-colors duration-200">Legal</a>
          <a href="#" class="cursor-pointer hover:text-primary transition-colors duration-200">Site Map</a>
        </div>
      </div>
    </div>
  </footer>
</div>
