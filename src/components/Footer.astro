---
import { Image } from 'astro:assets';
import htisLogo from '~/assets/htis-logo.png';
import TwitterIcon from './icons/TwitterIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import LinkedInIcon from './icons/LinkedInIcon.astro';
import PhoneIcon from './icons/PhoneIcon.astro';
import EnvelopeIcon from './icons/EnvelopeIcon.astro';
---

<footer
  class="relative z-10 mx-4 -mt-20 rounded-3xl bg-white px-4 pt-32 pb-8 md:mx-8 md:-mt-32 md:rounded-[3rem] md:pt-48 xl:mx-auto xl:max-w-[1400px]"
>
  <div class="mx-auto max-w-7xl">
    <div
      class="footer pb-16 text-base-content/80 lg:flex lg:w-full lg:flex-row lg:justify-between lg:gap-8"
    >
      <!-- Logo and Description -->
      <aside class="max-w-xs space-y-4">
        <Image src={htisLogo} alt="HTIS Logo" width={120} class="object-contain" />
        <p class="mt-4 text-lg leading-relaxed text-base-content/60">
          HTIS is a thriving community where innovators, professionals, and enthusiasts
          come together to share knowledge, collaborate, and grow.
        </p>

        <!-- Social Icons (Placeholders) -->
        <div class="mt-4 flex gap-4 text-[#2a453d]">
          <a
            href="#"
            aria-label="Twitter"
            target="_blank"
            rel="noopener noreferrer"
            class="cursor-pointer transition-colors hover:text-primary"
          >
            <TwitterIcon class="h-5 w-5" />
          </a>
          <a
            href="#"
            aria-label="Instagram"
            target="_blank"
            rel="noopener noreferrer"
            class="cursor-pointer transition-colors hover:text-primary"
          >
            <InstagramIcon class="h-5 w-5" />
          </a>
          <a
            href="#"
            aria-label="LinkedIn"
            target="_blank"
            rel="noopener noreferrer"
            class="cursor-pointer transition-colors hover:text-primary"
          >
            <LinkedInIcon class="h-5 w-5" />
          </a>
        </div>
      </aside>

      <!-- Links List -->
      <nav>
        <h6 class="footer-title mb-2 text-lg text-[#2a453d] normal-case opacity-100">
          Company
        </h6>
        <a href="#" class="mb-1 link link-hover hover:text-primary">About us</a>
        <a href="#" class="mb-1 link link-hover hover:text-primary">Services</a>
        <a href="#" class="mb-1 link link-hover hover:text-primary">Community</a>
        <a href="#" class="mb-1 link link-hover hover:text-primary">Testimonial</a>
      </nav>

      <nav>
        <h6 class="footer-title mb-2 text-lg text-[#2a453d] normal-case opacity-100">
          Services
        </h6>
        <a href="#" class="mb-1 link link-hover hover:text-primary">Web Technologies</a>
        <a href="#" class="mb-1 link link-hover hover:text-primary">Telecom</a>
        <a href="#" class="mb-1 link link-hover hover:text-primary">Manpower</a>
        <a href="#" class="mb-1 link link-hover hover:text-primary">System Integration</a>
      </nav>

      <nav>
        <h6 class="footer-title mb-2 text-lg text-[#2a453d] normal-case opacity-100">
          Our communities
        </h6>
        <a href="#" class="mb-1 link link-hover hover:text-primary">Communities</a>
        <a href="#" class="mb-1 link link-hover hover:text-primary">Forum</a>
        <a href="#" class="mb-1 link link-hover hover:text-primary">Chat</a>
      </nav>

      <!-- Contact List -->
      <nav>
        <h6 class="footer-title mb-2 text-lg text-[#2a453d] normal-case opacity-100">
          Contact
        </h6>
        <div class="mb-2 flex items-center gap-2">
          <PhoneIcon class="h-5 w-5 text-primary" />
          <span>+123 456 7890</span>
        </div>
        <div class="flex items-center gap-2">
          <EnvelopeIcon class="h-5 w-5 text-primary" />
          <span>support@htis.com</span>
        </div>
      </nav>
    </div>

    <!-- Bottom Bar -->
    <div
      class="flex flex-col items-center justify-between border-t border-base-200 pt-8 text-sm text-base-content/60 md:flex-row"
    >
      <p>© 2026. All rights reserved.</p>
      <div class="mt-4 flex gap-6 md:mt-0">
        <a href="#" class="cursor-pointer hover:text-primary">Privacy Policy</a>
        <a href="#" class="cursor-pointer hover:text-primary">Terms of Use</a>
        <a href="#" class="cursor-pointer hover:text-primary">Legal</a>
        <a href="#" class="cursor-pointer hover:text-primary">Site Map</a>
      </div>
    </div>
  </div>
</footer>
