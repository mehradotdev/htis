---
import { Image } from 'astro:assets';
import infoImg1 from '~/assets/lob-telecom-info-1.png';
import infoImg2 from '~/assets/lob-telecom-info-2.png';
import infoImg3 from '~/assets/lob-telecom-info-3.png';
import infoImg4 from '~/assets/lob-telecom-info-4.png';
import infoImg5 from '~/assets/lob-telecom-info-5.png';
import infoImg6 from '~/assets/lob-telecom-info-6.png';
import infoImg7 from '~/assets/lob-telecom-info-7.png';
import { telecomProcesses } from '~/data/pageDataTelecom';
import { ArrowUpRight, Network, Users, Code } from '@lucide/astro';
import TelecomProcesses from './TelecomProcesses.svelte';
import TelecomDeployments from './TelecomDeployments.svelte';
import TelecomMetrics from './TelecomMetrics.svelte';

const processImages = [
  infoImg1.src,
  infoImg2.src,
  infoImg3.src,
  infoImg4.src,
  infoImg5.src,
  infoImg6.src,
  infoImg7.src,
];
---

<!-- 1. Telecom Processes - Blueprint to Reality -->
<TelecomProcesses processes={telecomProcesses} images={processImages} client:visible />

<!-- 2. Proven Network Deployments -->
<TelecomDeployments client:visible />

<!-- 3. Built to Execute. Scaled to Deliver. -->
<section class="relative bg-base-200/50 py-24">
  <div class="container mx-auto px-6">
    <div class="mb-16 max-w-2xl">
      <h2 class="mb-6 text-4xl leading-tight font-bold text-base-content md:text-5xl">
        Built to Execute.<br />Scaled to Deliver.
      </h2>
    </div>

    <!-- Stats -->
    <TelecomMetrics client:visible />

    <!-- Pillars -->
    <div
      class="mt-16 grid grid-cols-1 border-y-2 border-base-content/20 py-12 md:grid-cols-3 lg:mt-20 lg:py-16"
    >
      <div class="flex flex-col gap-4 pb-12 md:pr-10 md:pb-0 lg:pr-14">
        <div
          class="mb-2 flex h-14 w-14 items-center justify-center rounded-2xl border border-base-content/5 bg-base-100 text-primary shadow-sm"
        >
          <Network class="h-8 w-8" />
        </div>
        <h3 class="text-xl font-bold">
          Converged IT Infrastructure & Systems Integration
        </h3>
        <p class="text-lg text-base-content/70">
          Architecting the high-availability IT fabrics that power mission-critical
          network operations. We provide the end-to-end IT backbone for modern Telcos,
          ranging from Tier III/IV Data Center engineering and virtualization to
          software-defined networking (SDN) and high-density compute environments.
        </p>
      </div>
      <div
        class="flex flex-col gap-4 border-y-2 border-base-content/20 py-12 md:border-x-2 md:border-y-0 md:px-10 md:py-0 lg:px-14"
      >
        <div
          class="mb-2 flex h-14 w-14 items-center justify-center rounded-2xl border border-base-content/5 bg-base-100 text-primary shadow-sm"
        >
          <Users class="h-8 w-8" />
        </div>
        <h3 class="text-xl font-bold">Specialized Technical Resourcing & Deployment</h3>
        <p class="text-lg text-base-content/70">
          Scalable L1–L6 talent solutions engineered for complex, multi-region telecom
          rollouts. We bridge the technical skill gap by deploying a domain-expert
          workforce. From high-niche technical architects (L6) to scalable field
          engineering units (L1), we provide the human capital required for operational
          excellence.
        </p>
      </div>
      <div class="flex flex-col gap-4 pt-12 md:pt-0 md:pl-10 lg:pl-14">
        <div
          class="mb-2 flex h-14 w-14 items-center justify-center rounded-2xl border border-base-content/5 bg-base-100 text-primary shadow-sm"
        >
          <Code class="h-8 w-8" />
        </div>
        <h3 class="text-xl font-bold">
          Enterprise Software Engineering & On-Demand Solutions
        </h3>
        <p class="text-lg text-base-content/70">
          Bespoke digital assets and SaaS platforms tailored for government and corporate
          scale. We build the intelligence that drives connectivity. Specializing in
          on-demand software development, we deliver secure, high-compliance digital
          assets—including our proprietary ERP systems—designed for the most demanding
          regulatory environments.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .hide-scrollbar {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
</style>
