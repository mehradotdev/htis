---
import { Image } from 'astro:assets';
import { Users, Wrench, Maximize, UserCheck } from '@lucide/astro';
import ResourcingWorkforce from './ResourcingWorkforce.svelte';
import ResourcingMetrics from './ResourcingMetrics.svelte';

import team1 from '~/assets/lob-resourcing-construction-1.png';
import team2 from '~/assets/lob-resourcing-construction-2.png';
import team3 from '~/assets/lob-resourcing-construction-3.png';

import wf1 from '~/assets/lob-resourcing-workforce-1.png';
import wf2 from '~/assets/lob-resourcing-workforce-2.png';
import wf3 from '~/assets/lob-resourcing-workforce-3.png';

import cs1 from '~/assets/lob-resourcing-case-study-1.png';
import cs2 from '~/assets/lob-resourcing-case-study-2.png';
import cs3 from '~/assets/lob-resourcing-case-study-3.png';

const workforceImages = [wf1.src, wf2.src, wf3.src];
---

<!-- 1. Build Amazing Teams, On Demand -->
<section class="relative bg-base-200/50 py-24">
  <div class="container mx-auto px-6">
    <div class="mb-16">
      <h2 class="mb-4 text-4xl font-bold text-base-content md:text-5xl">
        Engineered Human Capital: The HTIS Standard
      </h2>
      <p class="text-lg text-base-content/70">
        A performance-driven framework for rapid deployment and operational excellence.
      </p>
    </div>

    <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
        <div class="flex flex-col gap-4">
          <Users class="h-12 w-12 text-[#60B68C]" />
          <h3 class="text-xl font-bold text-base-content">Agile Resource Scaling</h3>
          <p class="text-base-content/70">
            High-Velocity Deployment at Scale We specialize in rapid-deployment cycles for
            large-scale network rollouts, delivering high-volume technical teams to the
            field within compressed timelines to meet critical expansion milestones.
          </p>
        </div>
        <div class="flex flex-col gap-4">
          <Wrench class="h-12 w-12 text-[#60B68C]" />
          <h3 class="text-xl font-bold text-base-content">Precision Technical Vetting</h3>
          <p class="text-base-content/70">
            98% Trial-to-Hire Success Rate Our rigorous job-description validation process
            ensures a near-perfect technical match by subjecting every L1–L6 specialist to
            exhaustive technical benchmarking and background verification before site
            deployment.
          </p>
        </div>
        <div class="flex flex-col gap-4">
          <Maximize class="h-12 w-12 text-[#60B68C]" />
          <h3 class="text-xl font-bold text-base-content">
            Zero-Risk Statutory Compliance
          </h3>
          <p class="text-base-content/70">
            100% Adherence to Global Standards We eliminate financial and safety risks for
            our clients by providing absolute adherence to PF, ESIC, and statutory labor
            mandates alongside comprehensive insurance coverage.
          </p>
        </div>
        <div class="flex flex-col gap-4">
          <UserCheck class="h-12 w-12 text-[#60B68C]" />
          <h3 class="text-xl font-bold text-base-content">
            Sustained Operational Reliability
          </h3>
          <p class="text-base-content/70">
            Commitment to Ongoing Infrastructure Health Focused on long-term
            infrastructure stability, our workforce model prioritizes operational
            continuity through a strategic shift toward ongoing support rather than
            short-term project deployments.
          </p>
        </div>
      </div>

      <div class="relative mt-10 h-[400px] w-full md:h-[500px] lg:mt-0">
        <div
          class="absolute top-0 right-0 z-10 h-48 w-2/3 overflow-hidden rounded-xl border-4 border-base-100 shadow-lg md:h-64"
        >
          <Image src={team1} alt="Team Working" class="h-full w-full object-cover" />
        </div>
        <div
          class="absolute right-8 bottom-0 z-30 h-48 w-2/3 overflow-hidden rounded-xl border-4 border-base-100 shadow-xl md:right-12 md:h-64"
        >
          <Image src={team2} alt="Team Planning" class="h-full w-full object-cover" />
        </div>
        <div
          class="absolute top-24 left-0 z-20 h-48 w-2/3 overflow-hidden rounded-xl border-4 border-base-100 shadow-md md:top-32 md:h-64"
        >
          <Image src={team3} alt="Team Discussion" class="h-full w-full object-cover" />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 2. One modern experience for today's workforce -->
<section class="relative bg-base-100 py-24">
  <div class="container mx-auto px-6">
    <ResourcingWorkforce images={workforceImages} client:visible />
  </div>
</section>

<!-- 3. Metrics and 4. Case Studies -->
<section class="relative bg-base-200/30 py-24">
  <div class="container mx-auto px-6">
    <ResourcingMetrics client:visible />

    <div class="mt-16">
      <h3 class="mb-10 text-3xl font-bold text-[#3A5D4A] text-base-content md:text-4xl">
        Collaboration with Leading Brands
      </h3>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        <div
          class="flex flex-col overflow-hidden rounded-2xl border border-base-content/10 bg-base-100 shadow-sm"
        >
          <div class="aspect-[4/3] w-full overflow-hidden bg-base-200 md:aspect-video">
            <Image src={cs1} alt="Case Study 1" class="h-full w-full object-cover" />
          </div>
          <div class="flex flex-1 flex-col gap-6 p-8">
            <p class="text-lg font-medium text-base-content/80">
              Deployed multi-level technical manpower for nationwide telecom rollout
              across multiple circle
            </p>
            <a
              href="#"
              class="mt-auto flex items-center gap-1 font-medium text-[#60B68C] hover:underline"
              >Read Full case-study <span aria-hidden="true">&rarr;</span></a
            >
          </div>
        </div>

        <div
          class="flex flex-col overflow-hidden rounded-2xl border border-base-content/10 bg-base-100 shadow-sm"
        >
          <div class="aspect-[4/3] w-full overflow-hidden bg-base-200 md:aspect-video">
            <Image src={cs2} alt="Case Study 2" class="h-full w-full object-cover" />
          </div>
          <div class="flex flex-1 flex-col gap-6 p-8">
            <p class="text-lg font-medium text-base-content/80">
              Deployed multi-level technical manpower for nationwide telecom rollout
              across multiple circle
            </p>
            <a
              href="#"
              class="mt-auto flex items-center gap-1 font-medium text-[#60B68C] hover:underline"
              >Read Full case-study <span aria-hidden="true">&rarr;</span></a
            >
          </div>
        </div>

        <div
          class="flex flex-col overflow-hidden rounded-2xl border border-base-content/10 bg-base-100 shadow-sm"
        >
          <div class="aspect-[4/3] w-full overflow-hidden bg-base-200 md:aspect-video">
            <Image src={cs3} alt="Case Study 3" class="h-full w-full object-cover" />
          </div>
          <div class="flex flex-1 flex-col gap-6 p-8">
            <p class="text-lg font-medium text-base-content/80">
              Deployed multi-level technical manpower for nationwide telecom rollout
              across multiple circle
            </p>
            <a
              href="#"
              class="mt-auto flex items-center gap-1 font-medium text-[#60B68C] hover:underline"
              >Read Full case-study <span aria-hidden="true">&rarr;</span></a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
