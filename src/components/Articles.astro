---
import ArrowRightIcon from './icons/ArrowRightIcon.astro';

const posts = [
  {
    src: 'https://www.linkedin.com/embed/feed/update/urn:li:share:7461429421330182144?collapsed=1',
    url: 'https://www.linkedin.com/feed/update/urn:li:share:7461429421330182144',
    height: 670,
    title: 'Why does your network work perfectly at 11 AM… and struggle by 3 PM?',
  },
  {
    src: 'https://www.linkedin.com/embed/feed/update/urn:li:share:7458505761942319104?collapsed=1',
    url: 'https://www.linkedin.com/feed/update/urn:li:share:7458505761942319104',
    height: 670,
    title:
      'How often do your teams struggle with slow systems or inconsistent performance?',
  },
  {
    src: 'https://www.linkedin.com/embed/feed/update/urn:li:ugcPost:7454530227554361344?collapsed=1',
    url: 'https://www.linkedin.com/feed/update/urn:li:ugcPost:7454530227554361344',
    height: 567,
    title:
      'Is your telecom and IT infrastructure aligned where enterprises are heading in 2026?',
  },
];
---

<section class="relative mx-auto max-w-6xl px-4 py-20" id="articles">
  <div class="border-t border-b border-base-content/20 py-16">
    <!-- Section header -->
    <div class="mb-12 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="mb-1 text-sm font-semibold tracking-widest text-primary uppercase">
          Insights
        </p>
        <h2 class="text-2xl font-semibold text-base-content md:text-3xl">
          Latest from our LinkedIn
        </h2>
      </div>
      <a
        href="https://www.linkedin.com/company/htis-telecom/posts/"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center text-sm font-medium text-primary decoration-2 hover:underline"
      >
        View all posts
        <ArrowRightIcon class="ml-1 h-4 w-4" />
      </a>
    </div>

    <!-- LinkedIn embeds -->
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post, i) => (
          <div
            class="li-embed-wrapper relative overflow-hidden rounded-xl"
            style={`min-height:${post.height}px;`}
          >
            {/* Fallback card — shown by default, hidden via JS once iframe loads */}
            <a
              href={post.url}
              target="_blank"
              rel="noopener noreferrer"
              class="li-fallback absolute inset-0 flex flex-col items-center justify-center gap-4 rounded-xl border border-base-content/10 bg-base-100 p-8 text-center transition hover:shadow-md"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                class="h-10 w-10 text-[#0A66C2]"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
              <p class="text-sm leading-snug font-medium text-base-content/70">
                {post.title}
              </p>
              <span class="flex items-center gap-1 text-xs font-semibold text-primary">
                View on LinkedIn
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-3.5 w-3.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 17L17 7M7 7h10v10" />
                </svg>
              </span>
            </a>

            {/* The actual iframe */}
            <iframe
              src={post.src}
              height={post.height}
              width="504"
              allowfullscreen
              title={post.title}
              data-index={i}
              class="li-iframe relative z-10 opacity-0 transition-opacity duration-300"
              style={`width:100%;height:${post.height}px;border:none;`}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLIFrameElement>('.li-iframe').forEach((iframe) => {
    iframe.addEventListener('load', () => {
      // If the iframe loaded real content, show it and hide the fallback
      try {
        const wrapper = iframe.closest('.li-embed-wrapper');
        const fallback = wrapper?.querySelector<HTMLElement>('.li-fallback');
        if (fallback) fallback.style.display = 'none';
        iframe.classList.remove('opacity-0');
        iframe.classList.add('opacity-100');
      } catch {
        // blocked — leave fallback visible
      }
    });
  });
</script>
