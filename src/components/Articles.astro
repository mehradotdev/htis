---
import ExclamationTriangleIcon from './icons/ExclamationTriangleIcon.astro';
import ArrowRightIcon from './icons/ArrowRightIcon.astro';
---

<section class="relative mx-auto max-w-6xl px-4 py-20">
  <!-- Top and Bottom borders as seen in screenshot -->
  <div class="border-t border-b border-base-content/20 py-16">
    <div class="flex flex-col gap-8 md:flex-row">
      <!-- Right Side is a single large feature block -->
      <div class="flex flex-col justify-center space-y-4 pr-8 md:w-[45%]">
        <h2 class="text-2xl leading-snug font-semibold text-[#2a453d] md:text-3xl">
          Combating fraud in <br /> Telecommunications
        </h2>
        <a
          href="#"
          class="flex items-center font-medium text-primary decoration-2 hover:underline"
        >
          Read Article
          <ArrowRightIcon class="ml-1 h-5 w-5" />
        </a>

        <!-- Fake image graphic placeholder representing the purple card seen in screenshot -->
        <div
          class="relative mt-8 flex min-h-[220px] max-w-sm items-center justify-center overflow-hidden rounded-md border-2 border-dashed border-[#8c52ff] bg-[#e8ccff] p-4 shadow"
        >
          <!-- Inner white alert box -->
          <div
            class="flex w-3/4 items-center gap-4 rounded-sm border border-base-content/10 bg-base-100 p-4 shadow-sm"
          >
            <div class="flex h-10 w-10 items-center justify-center rounded bg-error/20">
              <ExclamationTriangleIcon class="h-6 w-6 text-error" />
            </div>
            <div>
              <div class="text-sm font-bold text-base-content">Fraud</div>
              <div
                class="text-[10px] font-semibold tracking-wide text-base-content/60 uppercase"
              >
                Flagged by: ****
              </div>
            </div>
          </div>
        </div>

        <div
          class="mt-4 inline-flex w-max items-center gap-4 rounded-full border border-base-content/20 bg-base-100 px-4 py-1.5"
        >
          <span class="text-sm font-medium text-base-content/80">Telecom</span>
          <span class="text-sm text-base-content/50">2 min read</span>
        </div>
      </div>

      <!-- Vertical divider -->
      <div class="hidden w-px bg-base-content/20 md:block"></div>

      <!-- Left Side is a list of smaller feature blocks -->
      <div class="relative flex flex-col justify-center space-y-10 pl-8 md:w-[50%]">
        <div class="absolute top-0 right-0 bottom-0 w-1 rounded-full bg-primary/20"></div>

        <!-- Article Item 1 -->
        <div class="border-b border-base-content/10 pb-8">
          <h3 class="mb-4 text-xl font-semibold text-[#2a453d] md:text-2xl">
            Driving fintech growth through Cloud computing
          </h3>
          <a
            href="#"
            class="mb-6 flex items-center text-sm font-medium text-primary decoration-2 hover:underline"
          >
            Read Article
            <ArrowRightIcon class="ml-1 h-4 w-4" />
          </a>
          <div
            class="inline-flex w-max items-center gap-4 rounded-full border border-base-content/20 bg-base-100 px-4 py-1.5"
          >
            <span class="text-xs font-medium text-base-content/80">Telecom</span>
            <span class="text-xs text-base-content/50">2 min read</span>
          </div>
        </div>

        <!-- Article Item 2 -->
        <div>
          <h3 class="mb-4 text-xl font-semibold text-[#2a453d] md:text-2xl">
            Driving fintech growth through Cloud computing
          </h3>
          <a
            href="#"
            class="mb-6 flex items-center text-sm font-medium text-primary decoration-2 hover:underline"
          >
            Read Article
            <ArrowRightIcon class="ml-1 h-4 w-4" />
          </a>
          <div
            class="inline-flex w-max items-center gap-4 rounded-full border border-base-content/20 bg-base-100 px-4 py-1.5"
          >
            <span class="text-xs font-medium text-base-content/80">Telecom</span>
            <span class="text-xs text-base-content/50">2 min read</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
