  Activity,
  AlertTriangle,
  ArrowRight,
  Award,
  Banknote,
  Blocks,
  BookOpen,
  Briefcase,
  Building,
  Building2,
  Cable,
  Cctv,
  CheckCircle2,
  CheckSquare,
  CircleDollarSign,
  CircleQuestionMark,
  ClipboardList,
  Clock,
  Cloud,
  Code,
  Cpu,
  Database,
  Factory,
  FileCheck,
  FileCode,
  FileSignature,
  Fingerprint,
  HardDrive,
  HardHat,
  Headset,
  HeartPulse,
  Info,
  Landmark,
  Laptop,
  Layout,
  Lock,
  MapPin,
  Maximize,
  Monitor,
  MonitorSmartphone,
  Network,
  Phone,
  Plug,
  Radio,
  RadioTower,
  RefreshCw,
  Route,
  Scale,
  Server,
  Shield,
  ShieldCheck,
  Signal,
  Smartphone,
  TrendingUp,
  UserCheck,
  UserPlus,
  UserSearch,
  Users,
  Wifi,
  Wrench,
  Zap,
} from '@lucide/astro';

interface Props {
  name?: string;
  className?: string;
}

const { name, className } = Astro.props;

const iconMap = {
  Activity,
  AlertTriangle,
  ArrowRight,
  Award,
  Banknote,
  Blocks,
  BookOpen,
  Briefcase,
  Building,
  Building2,
  Cable,
  Cctv,
  CheckCircle2,
  CheckSquare,
  CircleDollarSign,
  ClipboardList,
  Clock,
  Cloud,
  Code,
  Cpu,
  Database,
  Factory,
  FileCheck,
  FileCode,
  FileSignature,
  Fingerprint,
  HardDrive,
  HardHat,
  Headset,
  HeartPulse,
  Info,
  Landmark,
  Laptop,
  Layout,
  Lock,
  MapPin,
  Maximize,
  Monitor,
  MonitorSmartphone,
  Network,
  Phone,
  Plug,
  Radio,
  RadioTower,
  RefreshCw,
  Route,
  Scale,
  Server,
  Shield,
  ShieldCheck,
  Signal,
  Smartphone,
  TrendingUp,
  UserCheck,
  UserPlus,
  UserSearch,
  Users,
  Wifi,
  Wrench,
  Zap,
} as const;

const Icon =
  name && name in iconMap ? iconMap[name as keyof typeof iconMap] : CircleQuestionMark;
---

<Icon class={className} />

