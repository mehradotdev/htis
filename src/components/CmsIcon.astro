---
import {
  AlertTriangle,
  ArrowRight,
  Award,
  Briefcase,
  Building2,
  CheckCircle2,
  CircleQuestionMark,
  Code,
  Factory,
  HardHat,
  HeartPulse,
  Info,
  Landmark,
  Phone,
  RadioTower,
  Server,
  ShieldCheck,
  TrendingUp,
  Users,
  Zap,
} from '@lucide/astro';

interface Props {
  name?: string;
  className?: string;
}

const { name, className } = Astro.props;

const iconMap = {
  AlertTriangle,
  ArrowRight,
  Award,
  Briefcase,
  Building2,
  CheckCircle2,
  Code,
  Factory,
  HardHat,
  HeartPulse,
  Info,
  Landmark,
  Phone,
  RadioTower,
  Server,
  ShieldCheck,
  TrendingUp,
  Users,
  Zap,
} as const;

const Icon =
  name && name in iconMap ? iconMap[name as keyof typeof iconMap] : CircleQuestionMark;
---

<Icon class={className} />

