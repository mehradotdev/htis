---
import { Image } from 'astro:assets';
import type { SoftwareOnboardingSection } from '~/data/cms';

type Props = SoftwareOnboardingSection;

const { backgroundImage, eyebrow, heading, steps } = Astro.props as Props;
const columnCount = Math.max(steps.length, 1);

const arrows = [
  { left: '5.5%', path: 'M 5,30 Q 100,0 195,27' },
  { left: '31.2%', path: 'M 5,20 Q 100,50 195,23' },
  { left: '57%', path: 'M 5,30 Q 100,0 195,27' },
];
---

<section class="relative overflow-hidden bg-[#163426] py-24 text-white">
  <!-- Background Image with custom overlay -->
  <div class="pointer-events-none absolute inset-0 z-0 select-none">
    <Image
      src={backgroundImage}
      alt=""
      aria-hidden="true"
      class="h-full w-full object-cover object-center opacity-25"
    />
    <div
      class="absolute inset-0 bg-linear-to-b from-[#163426]/95 via-transparent to-[#163426]/95"
    >
    </div>
  </div>

  <div class="relative z-10 container mx-auto px-6">
    <!-- Header -->
    <div class="mb-12 text-center">
      <span class="mb-4 block text-xs font-bold tracking-widest text-[#60B68C] uppercase">
        {eyebrow}
      </span>
      <h2
        class="mx-auto max-w-4xl text-3xl leading-tight font-extrabold tracking-tight md:text-5xl"
      >
        {heading}
      </h2>
    </div>

    <!-- Desktop Timeline Layout -->
    <div class="relative mx-auto mb-16 hidden max-w-6xl md:block">
      {
        arrows.slice(0, Math.max(steps.length - 1, 0)).map((arrow, index) => (
          <div
            class="pointer-events-none absolute top-[8px] z-0 h-12 w-[20%]"
            style={`left: ${arrow.left}`}
          >
            <svg
              class="h-full w-full overflow-visible"
              viewBox="0 0 200 50"
              fill="none"
              preserveAspectRatio="none"
            >
              <defs>
                <marker
                  id={`arrow-rm-${index + 1}`}
                  viewBox="0 0 10 10"
                  refX="6"
                  refY="5"
                  markerWidth="6"
                  markerHeight="6"
                  orient="auto-start-reverse"
                >
                  <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#60B68C" />
                </marker>
              </defs>
              <path
                d={arrow.path}
                stroke="#60B68C"
                stroke-width="2.5"
                stroke-dasharray="6,6"
                fill="none"
                marker-end={`url(#arrow-rm-${index + 1})`}
                class="opacity-75"
              />
            </svg>
          </div>
        ))
      }

      <!-- Row of Circles aligned exactly with the grid columns -->
      <div
        class="relative z-10 grid justify-items-start gap-8"
        style={`grid-template-columns: repeat(${columnCount}, minmax(0, 1fr))`}
      >
        {
          steps.map((step) => (
            <div class="group relative flex h-16 w-16 items-center justify-center rounded-full bg-white text-xl font-bold text-[#163426] shadow-xl transition-all duration-300 hover:scale-110 hover:bg-[#60B68C] hover:text-white">
              {step.number}
              <div class="absolute -inset-1.5 scale-0 rounded-full border border-white/20 transition-transform duration-300 group-hover:scale-100" />
            </div>
          ))
        }
      </div>

      <!-- Columns grid for details below circles -->
      <div
        class="mt-8 grid gap-8"
        style={`grid-template-columns: repeat(${columnCount}, minmax(0, 1fr))`}
      >
        {
          steps.map((step) => (
            <div class="flex flex-col gap-3">
              <h3 class="text-2xl font-medium tracking-wide text-white">{step.title}</h3>
              <p class="text-justify text-base leading-relaxed text-white/70">
                {step.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Mobile Timeline Layout -->
    <div
      class="relative mx-auto block max-w-lg pl-12 before:absolute before:top-4 before:bottom-4 before:left-[23px] before:w-[2px] before:border-l-2 before:border-dashed before:border-[#60B68C]/40 md:hidden"
    >
      {
        steps.map((step) => (
          <div class="relative mb-12 last:mb-0">
            <div class="absolute top-0 -left-12 z-10 flex h-12 w-12 items-center justify-center rounded-full bg-white text-lg font-bold text-[#163426] shadow-md">
              {step.number}
            </div>
            <div class="flex flex-col gap-2 text-left">
              <h3 class="text-xl font-bold text-white">{step.title}</h3>
              <p class="text-justify text-base leading-relaxed text-white/80">
                {step.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
