---
import { Image } from 'astro:assets';
import htisLogo from '~/assets/htis-logo.png';
import solutionsImg from '~/assets/lob-resourcing-construction-1.png';
import resourcesImg from '~/assets/lob-resourcing-case-study-1.png';
import MenuIcon from './icons/MenuIcon.astro';
import AnimatedThemeToggler from './AnimatedThemeToggler.svelte';

import {
  Phone,
  Server,
  Code,
  Users,
  Landmark,
  Building2,
  Factory,
  HeartPulse,
  HardHat,
  Award,
  Info,
  Briefcase,
  ChevronDown,
  ArrowRight,
  RadioTower,
} from '@lucide/astro';

const solutions = [
  {
    title: 'Telecom Services',
    desc: 'Connectivity and network operations',
    url: '/telecom',
    icon: Phone,
  },
  {
    title: 'System Integration',
    desc: 'End-to-end IT infrastructure',
    url: '/system-integration',
    icon: Server,
  },
  {
    title: 'Software Development',
    desc: 'Custom applications and platforms',
    url: '/software',
    icon: Code,
  },
  {
    title: 'Resource Management',
    desc: 'Skilled workforce solutions',
    url: '/resourcing',
    icon: Users,
  },
];

const industriesCol1 = [
  {
    title: 'Telcos and ISPs',
    desc: 'Network providers and ISPs',
    url: '/industry/telcos-and-isps',
    icon: RadioTower,
  },
  {
    title: 'Public Sector, Ministries & Defence',
    desc: 'Government and defense',
    url: '/industry/public-sector-ministries-defence',
    icon: Landmark,
  },
  {
    title: 'BFSI (Banking, Financial Services & Insurance)',
    desc: 'Banking and financial services',
    url: '/industry/bfsi',
    icon: Building2,
  },
  {
    title: 'Manufacturing, Automobile & FMCG',
    desc: 'Automotive and consumer goods',
    url: '/industry/manufacturing-automobile-fmcg',
    icon: Factory,
  },
  {
    title: 'Healthcare & Education',
    desc: 'Hospitals and academic institutions',
    url: '/industry/healthcare-education',
    icon: HeartPulse,
  },
];

const industriesCol2 = [
  {
    title: 'Real Estate, Infrastructure & Smart Spaces',
    desc: 'Infrastructure and smart cities',
    url: '/industry/real-estate-infrastructure-smart-spaces',
    icon: HardHat,
  },
  {
    title: 'View all Industries',
    desc: 'Explore all our industry solutions',
    url: '/industry',
    icon: ArrowRight,
  },
];

const resources = [
  {
    title: 'Awards & Achievements',
    desc: 'Our recognition and accolades',
    url: '/awards',
    icon: Award,
  },
  { title: 'About us', desc: 'Company overview and vision', url: '/about', icon: Info },
  // { title: 'Blogs', desc: 'Insights and industry news', url: '#', icon: FileText },
  {
    title: 'Case Studies',
    desc: 'Success stories and implementations',
    url: '/case-study',
    icon: Briefcase,
  },
];

const { pathname: rawPathname } = Astro.url;
const pathname = rawPathname.replace(/\/$/, '') || '/';

const isActive = (path: string) => {
  if (path === '/') {
    return pathname === '/';
  }
  return pathname.startsWith(path);
};

const isSolutionsActive = solutions.some((item) => pathname.startsWith(item.url));
const isIndustriesActive = pathname.startsWith('/industry');
const isResourcesActive = resources.some((item) => pathname.startsWith(item.url));
---

<div
  id="navbar-wrapper"
  class="fixed top-0 right-0 left-0 z-50 px-0 pt-0 transition-all duration-500 md:px-8 md:pt-3"
>
  <div
    id="navbar"
    class="navbar mx-auto max-w-7xl bg-transparent px-4 transition-all duration-500 md:px-6"
  >
    <div class="navbar-start w-auto lg:flex-1">
      <div class="dropdown">
        <label tabindex="0" class="btn text-primary btn-ghost lg:hidden">
          <MenuIcon class="h-5 w-5" />
        </label>
        <ul
          tabindex="0"
          class="dropdown-content menu z-1 mt-3 max-h-[85vh] w-[22rem] flex-nowrap overflow-y-auto rounded-box border border-base-200/50 bg-base-100 p-2 text-base font-medium text-base-content shadow-xl"
        >
          <li>
            <a
              href="/"
              class={`py-3 ${isActive('/') ? 'font-semibold text-primary bg-base-200/60' : 'text-base-content/80'}`}
            >
              Home
            </a>
          </li>

          <li>
            <details open={isSolutionsActive}>
              <summary
                class={`py-3 font-semibold ${isSolutionsActive ? 'text-primary' : ''}`}
                >Solutions</summary
              >
              <ul class="before:bg-base-200/50">
                {
                  solutions.map((item) => (
                    <li>
                      <a
                        href={item.url}
                        class={`py-3 ${isActive(item.url) ? 'bg-base-200/60 font-medium text-primary' : ''}`}
                      >
                        <item.icon
                          class={`mr-2 h-4 w-4 shrink-0 ${isActive(item.url) ? 'text-primary' : 'text-base-content/60'}`}
                        />
                        <span class="leading-tight">{item.title}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          </li>

          <li>
            <details open={isIndustriesActive}>
              <summary
                class={`py-3 font-semibold ${isIndustriesActive ? 'text-primary' : ''}`}
                >Industries</summary
              >
              <ul class="before:bg-base-200/50">
                {
                  [...industriesCol1, ...industriesCol2].map((item) => (
                    <li>
                      <a
                        href={item.url}
                        class={`py-2.5 ${isActive(item.url) ? 'bg-base-200/60 font-medium text-primary' : ''}`}
                      >
                        <item.icon
                          class={`mr-2 h-4 w-4 shrink-0 ${isActive(item.url) ? 'text-primary' : 'text-base-content/60'}`}
                        />
                        <span class="text-sm leading-tight">{item.title}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          </li>

          <li>
            <details open={isResourcesActive}>
              <summary
                class={`py-3 font-semibold ${isResourcesActive ? 'text-primary' : ''}`}
                >Resources</summary
              >
              <ul class="before:bg-base-200/50">
                {
                  resources.map((item) => (
                    <li>
                      <a
                        href={item.url}
                        class={`py-3 ${isActive(item.url) ? 'bg-base-200/60 font-medium text-primary' : ''}`}
                      >
                        <item.icon
                          class={`mr-2 h-4 w-4 shrink-0 ${isActive(item.url) ? 'text-primary' : 'text-base-content/60'}`}
                        />
                        <span class="leading-tight">{item.title}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          </li>

          <li>
            <a
              href="/jobs"
              class={`py-3 ${isActive('/jobs') ? 'font-semibold text-primary bg-base-200/60' : 'text-base-content/80'}`}
            >
              Career
            </a>
          </li>
        </ul>
      </div>
      <a href="/" class="btn h-auto p-2 text-xl normal-case btn-ghost">
        <Image
          src={htisLogo}
          alt="HTIS Logo"
          width={140}
          id="navbar-logo"
          class="w-[140px] object-contain transition-all duration-500"
        />
      </a>
    </div>
    <div class="navbar-center hidden h-full items-center lg:flex">
      <nav
        class="relative flex h-full items-center space-x-6 px-1 text-[16px] font-medium text-base-content/80"
        x-data="{ 
          activeDropdown: null,
          toggle(name) {
            this.activeDropdown = this.activeDropdown === name ? null : name;
          },
          close() {
            this.activeDropdown = null;
          }
        }"
        @click.away="close()"
        @keydown.escape.window="close()"
      >
        <a
          href="/"
          class={`py-4 transition-colors hover:text-primary ${isActive('/') ? 'text-primary font-semibold' : 'text-base-content/80'}`}
        >
          Home
        </a>

        <!-- Solutions: Dropdown open state, focus/hover sync, Escape key to close, and screen-reader accessibility (aria-expanded) managed via Alpine.js -->
        <div
          class="group/nav flex h-full items-center"
          @pointerenter="if ($event.pointerType !== 'touch') activeDropdown = 'solutions'"
          @pointerleave="if ($event.pointerType !== 'touch') activeDropdown = null"
          @focusin="activeDropdown = 'solutions'"
          @focusout="if (!$el.contains($event.relatedTarget)) activeDropdown = null"
        >
          <button
            type="button"
            class={`flex items-center gap-1 py-4 transition-colors hover:text-primary focus:text-primary focus:outline-none ${isSolutionsActive ? 'text-primary font-semibold' : 'text-base-content/80'}`}
            aria-haspopup="true"
            :aria-expanded="activeDropdown === 'solutions'"
            @click="toggle('solutions')"
          >
            Solutions
            <ChevronDown
              class="h-4 w-4 opacity-50 transition-transform duration-300"
              :class="activeDropdown === 'solutions' ? '-rotate-180 text-primary' : ''"
            />
          </button>

          <div
            class="absolute top-[85%] left-1/2 z-50 -translate-x-1/2 transform-gpu cursor-default pt-6 transition-all duration-300 invisible opacity-0 translate-y-2"
            :class="{ 'visible opacity-100 translate-y-0': activeDropdown === 'solutions', 'invisible opacity-0 translate-y-2': activeDropdown !== 'solutions' }"
          >
            <div
              class="flex w-[800px] gap-8 rounded-4xl border border-base-200 bg-base-100 p-6 shadow-2xl"
            >
              <div class="flex flex-1 flex-col gap-2">
                <h3
                  class="mb-2 px-3 text-xs font-bold tracking-widest text-base-content/50 uppercase"
                >
                  Our Solutions
                </h3>
                {
                  solutions.map((item) => (
                    <a
                      href={item.url}
                      class={`group/item flex items-start gap-4 rounded-2xl p-3 transition-all duration-300 hover:bg-base-200/50 ${isActive(item.url) ? 'bg-base-200/30' : ''}`}
                    >
                      <div
                        class={`mt-0.5 rounded-xl p-2.5 transition-all duration-300 ${isActive(item.url) ? 'bg-primary text-primary-content shadow-lg shadow-primary/20' : 'bg-primary/10 text-primary group-hover/item:bg-primary group-hover/item:text-primary-content group-hover/item:shadow-lg group-hover/item:shadow-primary/20'}`}
                      >
                        <item.icon class="h-5 w-5 shrink-0" />
                      </div>
                      <div>
                        <div
                          class={`font-bold transition-colors ${isActive(item.url) ? 'text-primary' : 'text-base-content group-hover/item:text-primary'}`}
                        >
                          {item.title}
                        </div>
                        <div class="mt-0.5 text-sm leading-snug text-base-content/60">
                          {item.desc}
                        </div>
                      </div>
                    </a>
                  ))
                }
              </div>
              <div
                class="group/card relative w-[300px] shrink-0 overflow-hidden rounded-3xl bg-base-200"
              >
                <Image
                  src={solutionsImg}
                  alt="Solutions"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover/card:scale-110"
                  width={300}
                />
                <div
                  class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"
                >
                </div>
                <div class="absolute right-0 bottom-0 left-0 p-6 text-left text-white">
                  <h4 class="mb-2 text-xl font-bold">Build the future</h4>
                  <p class="mb-6 text-sm text-white/80">
                    Discover our full range of enterprise solutions tailored for scale.
                  </p>
                  <a
                    href="/system-integration"
                    class="btn w-full rounded-lg border-none btn-sm btn-primary group-hover/card:shadow-[0_0_15px_rgba(var(--color-primary),0.5)]"
                  >
                    Explore Solutions <ArrowRight class="ml-1 h-4 w-4" />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Industries: Dropdown open state, focus/hover sync, Escape key to close, and screen-reader accessibility (aria-expanded) managed via Alpine.js -->
        <div
          class="group/nav flex h-full items-center"
          @pointerenter="if ($event.pointerType !== 'touch') activeDropdown = 'industries'"
          @pointerleave="if ($event.pointerType !== 'touch') activeDropdown = null"
          @focusin="activeDropdown = 'industries'"
          @focusout="if (!$el.contains($event.relatedTarget)) activeDropdown = null"
        >
          <button
            type="button"
            class={`flex items-center gap-1 py-4 transition-colors hover:text-primary focus:text-primary focus:outline-none ${isIndustriesActive ? 'text-primary font-semibold' : 'text-base-content/80'}`}
            aria-haspopup="true"
            :aria-expanded="activeDropdown === 'industries'"
            @click="toggle('industries')"
          >
            Industries
            <ChevronDown
              class="h-4 w-4 opacity-50 transition-transform duration-300"
              :class="activeDropdown === 'industries' ? '-rotate-180 text-primary' : ''"
            />
          </button>

          <div
            class="absolute top-[85%] left-1/2 z-50 -translate-x-1/2 transform-gpu cursor-default pt-6 transition-all duration-300 invisible opacity-0 translate-y-2"
            :class="{ 'visible opacity-100 translate-y-0': activeDropdown === 'industries', 'invisible opacity-0 translate-y-2': activeDropdown !== 'industries' }"
          >
            <div
              class="flex w-[850px] gap-6 rounded-4xl border border-base-200 bg-base-100 p-6 shadow-2xl"
            >
              <div class="flex flex-1 flex-col gap-2">
                <h3
                  class="mb-2 px-3 text-xs font-bold tracking-widest text-base-content/50 uppercase"
                >
                  Industries We Serve
                </h3>
                {
                  industriesCol1.map((item) => (
                    <a
                      href={item.url}
                      class={`group/item flex items-start gap-4 rounded-2xl p-3 transition-all duration-300 hover:bg-base-200/50 ${isActive(item.url) ? 'bg-base-200/30' : ''}`}
                    >
                      <div
                        class={`mt-0.5 rounded-xl p-2.5 transition-all duration-300 ${isActive(item.url) ? 'bg-primary text-primary-content shadow-lg shadow-primary/20' : 'bg-primary/10 text-primary group-hover/item:bg-primary group-hover/item:text-primary-content group-hover/item:shadow-lg group-hover/item:shadow-primary/20'}`}
                      >
                        <item.icon class="h-5 w-5 shrink-0" />
                      </div>
                      <div>
                        <div
                          class={`font-bold transition-colors ${isActive(item.url) ? 'text-primary' : 'text-base-content group-hover/item:text-primary'}`}
                        >
                          {item.title}
                        </div>
                        <div class="mt-0.5 text-sm leading-snug text-base-content/60">
                          {item.desc}
                        </div>
                      </div>
                    </a>
                  ))
                }
              </div>

              <div class="my-4 w-[1px] bg-base-200/60"></div>

              <div class="flex flex-1 flex-col gap-2 pt-8">
                {
                  industriesCol2.map((item) => (
                    <a
                      href={item.url}
                      class={`group/item flex items-start gap-4 rounded-2xl p-3 transition-all duration-300 hover:bg-base-200/50 ${isActive(item.url) ? 'bg-base-200/30' : ''}`}
                    >
                      <div
                        class={`mt-0.5 rounded-xl p-2.5 transition-all duration-300 ${isActive(item.url) ? 'bg-primary text-primary-content shadow-lg shadow-primary/20' : 'bg-primary/10 text-primary group-hover/item:bg-primary group-hover/item:text-primary-content group-hover/item:shadow-lg group-hover/item:shadow-primary/20'}`}
                      >
                        <item.icon class="h-5 w-5 shrink-0" />
                      </div>
                      <div>
                        <div
                          class={`font-bold transition-colors ${isActive(item.url) ? 'text-primary' : 'text-base-content group-hover/item:text-primary'}`}
                        >
                          {item.title}
                        </div>
                        <div class="mt-0.5 text-sm leading-snug text-base-content/60">
                          {item.desc}
                        </div>
                      </div>
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <!-- Resources: Dropdown open state, focus/hover sync, Escape key to close, and screen-reader accessibility (aria-expanded) managed via Alpine.js -->
        <div
          class="group/nav flex h-full items-center"
          @pointerenter="if ($event.pointerType !== 'touch') activeDropdown = 'resources'"
          @pointerleave="if ($event.pointerType !== 'touch') activeDropdown = null"
          @focusin="activeDropdown = 'resources'"
          @focusout="if (!$el.contains($event.relatedTarget)) activeDropdown = null"
        >
          <button
            type="button"
            class={`flex items-center gap-1 py-4 transition-colors hover:text-primary focus:text-primary focus:outline-none ${isResourcesActive ? 'text-primary font-semibold' : 'text-base-content/80'}`}
            aria-haspopup="true"
            :aria-expanded="activeDropdown === 'resources'"
            @click="toggle('resources')"
          >
            Resources
            <ChevronDown
              class="h-4 w-4 opacity-50 transition-transform duration-300"
              :class="activeDropdown === 'resources' ? '-rotate-180 text-primary' : ''"
            />
          </button>

          <div
            class="absolute top-[85%] left-1/2 z-50 -translate-x-1/2 transform-gpu cursor-default pt-6 transition-all duration-300 invisible opacity-0 translate-y-2"
            :class="{ 'visible opacity-100 translate-y-0': activeDropdown === 'resources', 'invisible opacity-0 translate-y-2': activeDropdown !== 'resources' }"
          >
            <div
              class="flex w-[800px] gap-8 rounded-4xl border border-base-200 bg-base-100 p-6 shadow-2xl"
            >
              <div class="flex flex-1 flex-col gap-2">
                <h3
                  class="mb-2 px-3 text-xs font-bold tracking-widest text-base-content/50 uppercase"
                >
                  Knowledge Hub
                </h3>
                {
                  resources.map((item) => (
                    <a
                      href={item.url}
                      class={`group/item flex items-start gap-4 rounded-2xl p-3 transition-all duration-300 hover:bg-base-200/50 ${isActive(item.url) ? 'bg-base-200/30' : ''}`}
                    >
                      <div
                        class={`mt-0.5 rounded-xl p-2.5 transition-all duration-300 ${isActive(item.url) ? 'bg-primary text-primary-content shadow-lg shadow-primary/20' : 'bg-primary/10 text-primary group-hover/item:bg-primary group-hover/item:text-primary-content group-hover/item:shadow-lg group-hover/item:shadow-primary/20'}`}
                      >
                        <item.icon class="h-5 w-5 shrink-0" />
                      </div>
                      <div>
                        <div
                          class={`font-bold transition-colors ${isActive(item.url) ? 'text-primary' : 'text-base-content group-hover/item:text-primary'}`}
                        >
                          {item.title}
                        </div>
                        <div class="mt-0.5 text-sm leading-snug text-base-content/60">
                          {item.desc}
                        </div>
                      </div>
                    </a>
                  ))
                }
              </div>
              <div
                class="group/card relative w-[300px] shrink-0 overflow-hidden rounded-3xl bg-base-200"
              >
                <Image
                  src={resourcesImg}
                  alt="Resources"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover/card:scale-110"
                  width={300}
                />
                <div
                  class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"
                >
                </div>
                <div class="absolute right-0 bottom-0 left-0 p-6 text-left text-white">
                  <h4 class="mb-2 text-xl font-bold">Our impact</h4>
                  <p class="mb-6 text-sm text-white/80">
                    Explore case studies and learn how we empower success globally.
                  </p>
                  <a
                    href="/case-study"
                    class="btn w-full rounded-lg border-none btn-sm btn-primary group-hover/card:shadow-[0_0_15px_rgba(var(--color-primary),0.5)]"
                  >
                    View Case Studies <ArrowRight class="ml-1 h-4 w-4" />
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <a
          href="/jobs"
          class={`py-4 transition-colors hover:text-primary ${isActive('/jobs') ? 'text-primary font-semibold' : 'text-base-content/80'}`}
        >
          Career
        </a>
      </nav>
    </div>
    <div class="navbar-end flex-1 gap-1 md:gap-2">
      <!-- Theme Toggle -->
      <AnimatedThemeToggler
        client:load
        className="btn btn-circle btn-ghost"
        duration={500}
        aria-label="Toggle theme"
      />

      <a
        href="#contact"
        class="btn rounded-lg px-4 text-base tracking-wide text-primary-content opacity-90 shadow-md btn-primary md:px-5"
        >Contact Us</a
      >
    </div>
  </div>
</div>

<script>
  function initNavbar() {
    function updateNavbar() {
      const navbar = document.getElementById('navbar');
      const logo = document.getElementById('navbar-logo');

      if (window.scrollY > 20) {
        // Normalize classes before adding specific variants
        navbar?.classList.remove(
          'max-w-7xl',
          'max-w-5xl',
          'bg-transparent',
          'bg-base-100/80',
          'bg-base-100/90',
          'backdrop-blur-md',
          'shadow-md',
          'shadow-sm',
          'rounded-[2rem]',
          'rounded-none',
          'py-0',
          'min-h-[4rem]',
          'min-h-[2.5rem]',
        );

        logo?.classList.remove('w-[140px]');
        logo?.classList.add('w-[100px]');
        navbar?.classList.add('min-h-[2.5rem]');

        if (window.matchMedia('(min-width: 1024px)').matches) {
          // Non-mobile: Boxy navbar - more compact and no borders
          navbar?.classList.add(
            'max-w-5xl',
            'bg-base-100/80',
            'backdrop-blur-md',
            'shadow-md',
            'rounded-[2rem]',
            'py-0',
          );
        } else {
          // Mobile: full width, visible bg
          navbar?.classList.add(
            'max-w-7xl',
            'bg-base-100/90',
            'backdrop-blur-md',
            'shadow-sm',
            'rounded-none',
          );
        }
      } else {
        // Top of page: Seamless navbar
        navbar?.classList.remove(
          'max-w-5xl',
          'bg-base-100',
          'bg-base-100/80',
          'bg-base-100/90',
          'backdrop-blur-md',
          'shadow-md',
          'shadow-sm',
          'rounded-[2rem]',
          'py-0',
          'min-h-[2.5rem]',
        );
        navbar?.classList.add(
          'max-w-7xl',
          'bg-transparent',
          'rounded-none',
          'min-h-[4rem]',
        );
        logo?.classList.remove('w-[100px]');
        logo?.classList.add('w-[140px]');
      }
    }

    // Event listeners
    window.addEventListener('scroll', updateNavbar);
    window.addEventListener('resize', updateNavbar);

    // Run once to set initial state
    updateNavbar();

    // Cleanup for View Transitions
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', updateNavbar);
        window.removeEventListener('resize', updateNavbar);
      },
      { once: true },
    );
  }

  // Initialize on hard load
  initNavbar();

  // Re-initialize after a swap (if using Astro ViewTransitions)
  document.addEventListener('astro:after-swap', initNavbar);
</script>
