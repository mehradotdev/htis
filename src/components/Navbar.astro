---
import { Image } from 'astro:assets';
import htisLogo from '~/assets/htis-logo.png';
import MenuIcon from './icons/MenuIcon.astro';
import { Sun, Moon } from '@lucide/astro';
---

<div
  id="navbar-wrapper"
  class="fixed top-0 right-0 left-0 z-50 px-0 pt-0 transition-all duration-500 md:px-8 md:pt-4"
>
  <div
    id="navbar"
    class="navbar mx-auto max-w-7xl bg-transparent px-4 transition-all duration-500 md:px-6"
  >
    <div class="navbar-start">
      <div class="dropdown">
        <label tabindex="0" class="btn text-primary btn-ghost lg:hidden">
          <MenuIcon class="h-5 w-5" />
        </label>
        <ul
          tabindex="0"
          class="dropdown-content menu z-[1] mt-3 w-52 rounded-box bg-base-100 p-2 text-lg font-medium text-base-content shadow"
        >
          <li><a href="/" class="font-semibold text-primary">Home</a></li>
          <li><a href="#">Product</a></li>
          <li><a href="#">FAQ</a></li>
          <li><a href="#">Blog</a></li>
          <li><a href="#">About Us</a></li>
        </ul>
      </div>
      <a href="/" class="btn h-auto p-2 text-xl normal-case btn-ghost">
        <Image src={htisLogo} alt="HTIS Logo" width={140} class="object-contain" />
      </a>
    </div>
    <div class="navbar-center hidden lg:flex">
      <ul
        class="menu menu-horizontal space-x-6 px-1 text-lg font-medium text-base-content/80"
      >
        <li><a href="/" class="font-semibold text-primary">Home</a></li>
        <li><a href="#">Product</a></li>
        <li><a href="#">FAQ</a></li>
        <li><a href="#">Blog</a></li>
        <li><a href="#">About Us</a></li>
      </ul>
    </div>
    <div class="navbar-end gap-2">
      <!-- Theme toggle -->
      <label
        id="theme-toggle-label"
        class="swap swap-rotate btn btn-ghost btn-circle"
        title="Toggle dark mode"
        aria-label="Toggle dark mode"
      >
        <input
          id="theme-toggle"
          type="checkbox"
          value="htis-theme-dark"
          class="theme-controller"
        />
        <!-- Sun icon (shown in dark mode — click to go light) -->
        <Sun class="swap-on h-5 w-5" size={20} />
        <!-- Moon icon (shown in light mode — click to go dark) -->
        <Moon class="swap-off h-5 w-5" size={20} />
      </label>

      <a
        href="#"
        class="btn rounded-full px-6 text-lg tracking-wide text-primary-content opacity-90 shadow-md btn-primary"
        >Contact Us</a
      >
    </div>
  </div>
</div>

<script>
  const LIGHT_THEME = 'htis-theme';
  const DARK_THEME = 'htis-theme-dark';
  const STORAGE_KEY = 'theme';

  function applyTheme(isDark: boolean) {
    const theme = isDark ? DARK_THEME : LIGHT_THEME;
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem(STORAGE_KEY, theme);
  }

  function syncToggle() {
    const toggle = document.getElementById('theme-toggle') as HTMLInputElement | null;
    if (!toggle) return;
    const saved = localStorage.getItem(STORAGE_KEY);
    toggle.checked = saved === DARK_THEME;
    toggle.addEventListener('change', () => applyTheme(toggle.checked));
  }

  function initNavbar() {
    // Sync theme toggle state
    syncToggle();

    function updateNavbar() {
      const navbar = document.getElementById('navbar');

      if (window.scrollY > 20) {
        // Normalize classes before adding specific variants
        navbar?.classList.remove(
          'max-w-7xl',
          'max-w-5xl',
          'bg-transparent',
          'bg-base-100/80',
          'bg-base-100/90',
          'backdrop-blur-md',
          'shadow-md',
          'shadow-sm',
          'rounded-[2rem]',
          'rounded-none',
          'py-1'
        );

        if (window.matchMedia('(min-width: 1024px)').matches) {
          // Non-mobile: Boxy navbar - more compact and no borders
          navbar?.classList.add(
            'max-w-5xl',
            'bg-base-100/80',
            'backdrop-blur-md',
            'shadow-md',
            'rounded-[2rem]',
            'py-1',
          );
        } else {
          // Mobile: full width, visible bg
          navbar?.classList.add(
            'max-w-7xl',
            'bg-base-100/90',
            'backdrop-blur-md',
            'shadow-sm',
            'rounded-none',
          );
        }
      } else {
        // Top of page: Seamless navbar
        navbar?.classList.remove(
          'max-w-5xl',
          'bg-base-100',
          'bg-base-100/80',
          'bg-base-100/90',
          'backdrop-blur-md',
          'shadow-md',
          'shadow-sm',
          'rounded-[2rem]',
          'py-1',
        );
        navbar?.classList.add('max-w-7xl', 'bg-transparent', 'rounded-none');
      }
    }

    // Event listeners
    window.addEventListener('scroll', updateNavbar);
    window.addEventListener('resize', updateNavbar);

    // Run once to set initial state
    updateNavbar();

    // Cleanup for View Transitions
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', updateNavbar);
        window.removeEventListener('resize', updateNavbar);
      },
      { once: true },
    );
  }

  // Initialize on hard load
  initNavbar();

  // Re-initialize after a swap (if using Astro ViewTransitions)
  document.addEventListener('astro:after-swap', initNavbar);
</script>
