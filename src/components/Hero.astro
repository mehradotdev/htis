---
import { Image } from 'astro:assets';
import heroBg from '~/assets/hero-bg.png';
import lifesizeLogo from '~/assets/lifesize-logo.png';
import honeywellLogo from '~/assets/honeywell-logo.png';
import nokiaLogo from '~/assets/nokia-logo.png';
import ericssonLogo from '~/assets/ericsson-logo.png';
import ncomputingLogo from '~/assets/ncomputing-logo.png';
import legrandLogo from '~/assets/legrand-logo.png';
---

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-100%);
    }
  }
  .animate-marquee {
    animation: marquee 30s linear infinite;
  }
</style>

<section
  class="relative flex min-h-[80vh] flex-col items-center justify-center overflow-hidden pt-28 pb-10"
>
  <!-- Background Image with Overlay -->
  <div class="pointer-events-none absolute inset-0 z-0 bg-base-100">
    <!-- Hero Image (Base Layer) -->
    <Image
      src={heroBg}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover opacity-80"
      style="filter: var(--filter-invert-dark)"
    />

    <!-- Green Gradient Overlay -->
    <div
      class="absolute inset-0 bg-linear-to-tr from-primary/30 via-transparent to-accent/40 mix-blend-multiply"
    >
    </div>

    <!-- Noise Overlay -->
    <div
      class="absolute inset-0 opacity-[0.4] mix-blend-overlay"
      style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"
    >
    </div>

    <!-- Bottom Fade (to blend with the rest of the page) -->
    <div
      class="absolute inset-x-0 bottom-0 h-32 bg-linear-to-t from-base-100 to-transparent"
    >
    </div>
  </div>

  <div
    class="relative z-10 mx-auto mt-20 flex w-full max-w-5xl flex-col items-center px-4 text-center"
  >
    <h1
      class="mb-6 text-4xl leading-[1.1] font-bold tracking-tight text-base-content sm:text-5xl md:text-6xl lg:text-[4.5rem]"
    >
      Delivering Excellence in <br />
      <span
        id="word-carousel"
        class="-mt-2 -mb-4 inline-grid overflow-hidden pt-2 pb-4 align-bottom text-primary"
      >
        <span
          class="word-item col-start-1 row-start-1 translate-y-0 opacity-100 transition-all duration-500 ease-out"
          >System Integrations</span
        >
        <span
          class="word-item col-start-1 row-start-1 translate-y-full opacity-0 transition-all duration-500 ease-out"
          aria-hidden="true">Telecommunications</span
        >
        <span
          class="word-item col-start-1 row-start-1 translate-y-full opacity-0 transition-all duration-500 ease-out"
          aria-hidden="true">Software Development</span
        >
        <span
          class="word-item col-start-1 row-start-1 translate-y-full opacity-0 transition-all duration-500 ease-out"
          aria-hidden="true">Manpower Services</span
        >
      </span>
    </h1>

    <p
      class="mx-auto mb-10 max-w-2xl text-xl font-medium text-base-content/70 md:text-2xl"
    >
      Reliable expertise across infrastructure, technology, and people.
    </p>

    <a
      href="#contact"
      class="btn rounded-full px-12 text-xl text-primary-content shadow-lg shadow-primary/20 btn-lg btn-primary"
    >
      Contact us
    </a>
  </div>

  <div
    class="relative z-10 mt-auto hidden w-full max-w-full overflow-hidden pt-24 pb-8 md:block"
  >
    <p class="mb-6 text-center text-base font-semibold text-base-content/60 md:text-lg">
      Trusted by 100+ Clients and Partners
    </p>

    <!-- Marquee Wrapper with Fade -->
    <div class="flex w-full mask-[linear-gradient(to_right,transparent_0,black_128px,black_calc(100%-128px),transparent_100%)]">
      <!-- Marquee Container -->
      <div
        class="group flex w-max opacity-70 transition-opacity duration-500 hover:opacity-100"
      >
      {
        Array.from({ length: 8 }).map((_, i) => (
          <div
            class="animate-marquee flex shrink-0 items-center gap-16 pr-16 group-hover:[animation-play-state:paused]"
            aria-hidden={i > 0 ? 'true' : undefined}
          >
            <Image
              src={ncomputingLogo}
              alt="NComputing"
              width={110}
              class="object-contain transition-all duration-300 hover:filter-none!"
              style="filter: var(--logo-filter)"
            />
            <Image
              src={legrandLogo}
              alt="Legrand"
              width={110}
              class="object-contain transition-all duration-300 hover:filter-none!"
              style="filter: var(--logo-filter)"
            />
            <Image
              src={lifesizeLogo}
              alt="Lifesize"
              width={110}
              class="object-contain transition-all duration-300 hover:filter-none!"
              style="filter: var(--logo-filter)"
            />
            <Image
              src={honeywellLogo}
              alt="Honeywell"
              width={110}
              class="object-contain transition-all duration-300 hover:filter-none!"
              style="filter: var(--logo-filter)"
            />
            <Image
              src={nokiaLogo}
              alt="Nokia"
              width={110}
              class="object-contain transition-all duration-300 hover:filter-none!"
              style="filter: var(--logo-filter)"
            />
            <Image
              src={ericssonLogo}
              alt="Ericsson"
              width={110}
              class="object-contain transition-all duration-300 hover:filter-none!"
              style="filter: var(--logo-filter)"
            />
          </div>
        ))
      }
    </div>
    </div>
  </div>
</section>

<script>
  let carouselInterval: ReturnType<typeof setInterval> | undefined;

  const setupWordCarousel = () => {
    const parent = document.getElementById('word-carousel');
    if (!parent) return;

    const items = Array.from(parent.querySelectorAll<HTMLElement>('.word-item'));
    if (!items.length) return;

    let currentIndex = 0;

    if (carouselInterval) clearInterval(carouselInterval);

    carouselInterval = setInterval(() => {
      const currentItem = items[currentIndex];
      currentIndex = (currentIndex + 1) % items.length;
      const nextItem = items[currentIndex];

      currentItem.classList.remove('translate-y-0', 'opacity-100');
      currentItem.classList.add('-translate-y-full', 'opacity-0');
      currentItem.setAttribute('aria-hidden', 'true');

      nextItem.style.transition = 'none';
      nextItem.classList.remove('-translate-y-full');
      nextItem.classList.add('translate-y-full');

      void nextItem.offsetWidth;

      nextItem.style.transition = '';
      nextItem.classList.remove('translate-y-full', 'opacity-0');
      nextItem.classList.add('translate-y-0', 'opacity-100');
      nextItem.removeAttribute('aria-hidden');
    }, 3000);
  };

  document.addEventListener('astro:page-load', setupWordCarousel);

  // Cleanup on page leave (for view transitions)
  document.addEventListener(
    'astro:before-swap', // or before-preparation, both work, but before-swap is when DOM is about to change
    () => {
      if (carouselInterval) clearInterval(carouselInterval);
      document.removeEventListener('astro:page-load', setupWordCarousel);
    },
    { once: true },
  );
</script>
