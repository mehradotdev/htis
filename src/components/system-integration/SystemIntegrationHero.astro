---
import { Image } from 'astro:assets';
import heroBg from '~/assets/hero-bg.png';
import LightRays from '~/components/LightRays.astro';
import SystemIntegrationCarousel from './SystemIntegrationCarousel.svelte';

import carousel1 from '~/assets/lob-system-hero-carousel-1.png';
import carousel2 from '~/assets/lob-system-hero-carousel-2.png';
import carousel3 from '~/assets/lob-system-hero-carousel-3.png';
import carousel4 from '~/assets/lob-system-hero-carousel-4.png';
---

<section
  class="relative flex min-h-[80vh] w-full flex-col justify-center overflow-hidden pt-28 pb-10 lg:min-h-[90vh] lg:flex-row lg:items-center lg:pt-0 lg:pb-0"
>
  <!-- Background Image with Overlay -->
  <div class="pointer-events-none absolute inset-0 z-0 bg-base-100">
    <Image
      src={heroBg}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 z-0 h-full w-full object-cover opacity-80"
      style="filter: var(--filter-invert-dark)"
    />

    <LightRays
      className="z-1 opacity-100"
      color="rgba(138, 255, 199, 0.52)"
      blur={54}
      count={13}
      speed={3}
      length="88vh"
      overlayOpacity={0.72}
    />

    <div
      class="absolute inset-0 z-2 bg-base-100/60 lg:bg-transparent lg:bg-linear-to-r lg:from-base-100/90 lg:via-base-100/50 lg:to-transparent"
    >
    </div>
    <div
      class="absolute inset-0 z-2 bg-linear-to-tr from-primary/10 via-transparent to-transparent mix-blend-multiply"
    >
    </div>
  </div>

  <div
    class="relative z-10 mx-auto flex h-full w-full max-w-7xl flex-col justify-center px-4 lg:px-8"
  >
    <div class="flex min-h-[60vh] flex-col lg:flex-row lg:items-center">
      <!-- Left part: Text Content -->
      <div
        class="z-20 w-full max-lg:rounded-2xl max-lg:bg-base-100/20 max-lg:p-6 max-lg:backdrop-blur-md lg:w-1/2 lg:py-24 lg:pr-12"
      >
        <h1
          class="mb-6 text-4xl leading-tight font-bold text-base-content sm:text-5xl lg:text-[54px]"
        >
          System Integration & IT Infrastructure
        </h1>
        <p class="mb-10 max-w-xl text-lg font-medium text-base-content/80 lg:text-xl">
          We don't just deploy hardware; we architect the digital nervous systems of
          modern enterprises. Our System Integration vertical bridges the gap between
          high-performance physical infrastructure and cognitive digital operations.
        </p>
        <a
          href="#contact"
          class="btn rounded-lg px-12 text-xl text-primary-content shadow-lg shadow-primary/20 btn-lg btn-primary"
        >
          Contact Us
        </a>
      </div>
    </div>
  </div>

  <!-- Right part: Background Image Carousel -->
  <div
    class="absolute inset-y-0 right-0 z-1 block w-full mask-[linear-gradient(to_right,transparent_0,black_40%,black_60%)] opacity-40 lg:block lg:w-[45%]"
  >
    <SystemIntegrationCarousel
      images={[carousel1.src, carousel2.src, carousel3.src, carousel4.src]}
      client:load
    />
  </div>
</section>
