---
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import caseStudyImg from '~/assets/lob-system-case-study-1.png';
---

<section class="relative bg-base-200/50 py-24">
  <div class="container mx-auto px-6">
    <!-- Header -->
    <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <h2 class="text-3xl font-bold text-base-content md:text-4xl">
        Integrated Infrastructure Deployments
      </h2>
      <a
        href="#"
        aria-label="View all integrated infrastructure deployments"
        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-primary/30 bg-base-200 text-primary transition-colors hover:bg-primary/5"
      >
        <ArrowRight class="h-6 w-6" stroke-width="2.5" />
      </a>
    </div>

    <!-- Content section with top and bottom borders -->
    <div class="border-t-2 border-b-2 border-base-content/20 py-12 md:py-16">
      <div class="flex flex-col gap-10 md:flex-row md:gap-8 lg:gap-12">
        <!-- Left part: Image + Main Feature -->
        <div class="flex flex-col gap-8 md:w-[60%] lg:w-[65%] lg:flex-row lg:gap-10">
          <!-- Image -->
          <div class="shrink-0">
            <Image
              src={caseStudyImg}
              alt="Enterprise Network Infrastructure"
              class="h-[217px] w-[198px] rounded-sm object-cover shadow-sm max-lg:aspect-square max-lg:h-auto max-lg:w-full max-lg:max-w-sm"
            />
          </div>

          <!-- Main Feature Text -->
          <div class="flex flex-col space-y-4 lg:pr-4">
            <h3 class="text-2xl font-semibold text-base-content">
              Enterprise Network Infrastructure
            </h3>
            <p class="text-lg text-base-content/70">
              From structured cabling to active network systems, we build reliable
              connectivity foundations that power enterprise communication and data flow.
            </p>
            <a
              href="#"
              class="mt-2 inline-flex w-max items-center text-sm font-medium text-primary decoration-2 underline-offset-4 hover:underline"
            >
              Read Case Study <ArrowRight class="ml-1 h-4 w-4" />
            </a>
          </div>
        </div>

        <!-- Vertical divider -->
        <div class="hidden w-[2px] bg-base-content/20 md:block"></div>

        <!-- Right part: Smaller features -->
        <div class="flex flex-col md:w-[40%] lg:w-[35%] lg:pl-4">
          <!-- Top Item -->
          <div class="border-b-2 border-base-content/20 pb-8">
            <h4 class="mb-3 text-xl font-semibold text-base-content">
              Surveillance & Security Integration
            </h4>
            <p class="mb-4 text-base text-base-content/70">
              Integrated CCTV, access control, and monitoring infrastructure designed to
              improve security visibility and operational oversight.
            </p>
            <a
              href="#"
              class="inline-flex items-center text-sm font-medium text-primary decoration-2 underline-offset-4 hover:underline"
            >
              Read Case Study <ArrowRight class="ml-1 h-4 w-4" />
            </a>
          </div>

          <!-- Bottom Item -->
          <div class="pt-8">
            <h4 class="mb-4 text-xl font-semibold text-base-content">
              Data Center & Server Integration
            </h4>
            <a
              href="#"
              class="inline-flex items-center text-sm font-medium text-primary decoration-2 underline-offset-4 hover:underline"
            >
              Read Case Study <ArrowRight class="ml-1 h-4 w-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
