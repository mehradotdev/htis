---
import CurvedLineIcon from './icons/CurvedLineIcon.astro';
import Globe from './Globe.svelte';
---

<section class="relative mx-auto max-w-6xl overflow-hidden px-4 py-24">
  <div
    class="relative isolate mx-4 transform-[translateZ(0)] overflow-hidden rounded-3xl border border-primary/20 bg-base-100 px-8 py-20 shadow-sm lg:mx-0 lg:px-16"
  >
    <!-- Subtle curved top line -->
    <div class="pointer-events-none absolute top-0 -mt-px flex w-full justify-center">
      <CurvedLineIcon width="600" height="40" />
    </div>

    <!-- Content Split -->
    <div
      class="relative z-10 flex flex-col items-center justify-between space-y-12 md:flex-row md:space-y-0"
    >
      <!-- Stats Side -->
      <div class="space-y-12 pb-40 md:w-1/2 md:pb-0">
        <div>
          <h2 class="mb-10 text-4xl font-bold text-base-content md:text-5xl">
            Global Footprint
          </h2>
        </div>

        <div class="grid gap-10">
          <div>
            <div class="flex items-baseline text-5xl font-light text-primary">
              40 <span class="ml-1 text-4xl">+</span>
            </div>
            <p class="mt-1 text-lg text-base-content/70">Global Markets Served</p>
          </div>

          <div>
            <div class="flex items-baseline text-5xl font-light text-primary">
              310 <span class="ml-1 text-4xl">+</span>
            </div>
            <p class="mt-1 text-lg text-base-content/70">
              Operational Cities Across India
            </p>
          </div>

          <div>
            <div class="flex items-baseline text-5xl font-light text-primary">
              25 <span class="ml-1 text-4xl">+</span>
            </div>
            <p class="mt-1 text-lg text-base-content/70">Regional Offices</p>
          </div>
        </div>
      </div>

      <!-- Globe spacer for flex layout (keeps stats side at 1/2 width) -->
      <div class="hidden md:block md:w-1/2"></div>
    </div>

    <!-- Globe Graphic — absolutely positioned to peek from the bottom right -->
    <div
      class="pointer-events-none absolute bottom-0 left-1/2 aspect-square w-[650px] -translate-x-1/2 translate-y-[45%] md:right-0 md:left-auto md:translate-x-[2%] md:translate-y-[45%]"
    >
      <Globe client:visible config={{ width: 650 }} className="" />
    </div>
  </div>
</section>
