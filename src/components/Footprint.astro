---
import CurvedLineIcon from './icons/CurvedLineIcon.astro';
import Globe from './Globe.svelte';
import type { FootprintMetric, GlobeMarker } from '~/data/cms';

interface Props {
  heading: string;
  metrics: FootprintMetric[];
  globe: {
    ariaLabel: string;
    markers: GlobeMarker[];
  };
}

const { heading, metrics, globe } = Astro.props;
const globeMarkers = globe.markers.map((marker) => ({
  name: marker.name,
  size: marker.size,
  location: [marker.latitude, marker.longitude] as [number, number],
}));
---

<section class="relative mx-auto max-w-6xl overflow-hidden px-4 py-24">
  <div
    class="relative isolate mx-4 transform-[translateZ(0)] overflow-visible rounded-3xl border border-primary/20 bg-base-100 px-8 py-20 shadow-sm lg:mx-0 lg:px-16"
  >
    <!-- Subtle curved top line -->
    <div class="pointer-events-none absolute top-0 -mt-px flex w-full justify-center">
      <CurvedLineIcon width="600" height="40" />
    </div>

    <!-- Content Split -->
    <div
      class="relative z-10 flex flex-col items-center justify-between gap-12 md:flex-row md:gap-8"
    >
      <!-- Stats Side -->
      <div class="w-full space-y-12 md:w-1/2">
        <div>
          <h2 class="mb-10 text-4xl font-bold text-base-content md:text-5xl">
            {heading}
          </h2>
        </div>

        <div class="grid gap-10">
          {
            metrics.map((metric) => (
              <div>
                <div class="flex items-baseline text-5xl font-light text-primary">
                  {metric.value}
                  {metric.suffix && <span class="ml-1 text-4xl">{metric.suffix}</span>}
                </div>
                <p class="mt-1 text-lg text-base-content/70">{metric.label}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Globe Column (Right Side) -->
      <div class="flex w-full items-center justify-center md:w-1/2">
        <div class="relative aspect-square w-full max-w-[500px] overflow-visible">
          <Globe
            client:visible
            config={{ width: 500 }}
            expandable={false}
            className=""
            markers={globeMarkers}
            ariaLabel={globe.ariaLabel}
          />
        </div>
      </div>
    </div>
  </div>
</section>
