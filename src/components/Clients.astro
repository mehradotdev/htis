---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ArrowRight } from '@lucide/astro';
import type { ClientLogo } from '~/data/cms';

interface Props {
  heading: string;
  ctaUrl: string;
  ctaLabel: string;
  logos: ClientLogo[];
}

const { heading, ctaUrl, ctaLabel, logos } = Astro.props;
const reversedLogos = [...logos].reverse();

// Helper to calculate elegant dynamic card width based on aspect ratio
function getCardWidth(img: ImageMetadata) {
  const aspectRatio = img.width / img.height;
  const targetLogoHeight = 56; // max-h-14 is 56px
  const calculatedWidth = Math.round(targetLogoHeight * aspectRatio) + 16;
  return Math.max(60, Math.min(300, calculatedWidth));
}
---

<section class="relative mx-auto max-w-6xl overflow-hidden px-4 pb-24">
  <div class="mb-10 flex items-center justify-between">
    <h2 class="text-3xl font-bold text-base-content md:text-5xl">
      {heading}
    </h2>
    <a
      href={ctaUrl}
      aria-label={ctaLabel}
      class="flex h-12 w-12 shrink-0 cursor-pointer items-center justify-center rounded-full border border-primary text-primary transition-colors hover:bg-primary hover:text-primary-content"
    >
      <ArrowRight class="h-6 w-6" />
    </a>
  </div>

  <!-- Marquee Wrapper with Fade -->
  <div
    class="flex w-full flex-col gap-4 mask-[linear-gradient(to_right,transparent_0,black_128px,black_calc(100%-128px),transparent_100%)]"
  >
    <!-- Row 1: Right to Left (order 1...30) -->
    <div class="marquee-group group flex w-max transition-opacity duration-500 hover:opacity-100">
      <div
        class="marquee-track flex shrink-0 items-center gap-4 pr-4"
        data-direction="left"
      >
        {
          logos.map((logo) => (
            <div
              class="flex h-[90px] shrink-0 items-center justify-center rounded-xl border-2 border-primary bg-base-100/50 py-3 px-2 shadow-sm backdrop-blur-sm transition-colors hover:bg-base-100"
              style={`width: ${getCardWidth(logo.image)}px;`}
            >
              <Image
                src={logo.image}
                alt={logo.alt}
                class="client-logo h-auto max-h-14 w-auto max-w-[260px] object-contain opacity-85 transition-opacity duration-300 hover:opacity-100"
              />
            </div>
          ))
        }
      </div>
      <!-- Duplicate list for seamless infinite scroll -->
      <div
        class="marquee-track flex shrink-0 items-center gap-4 pr-4"
        data-direction="left"
        aria-hidden="true"
      >
        {
          logos.map((logo) => (
            <div
              class="flex h-[90px] shrink-0 items-center justify-center rounded-xl border-2 border-primary bg-base-100/50 py-3 px-2 shadow-sm backdrop-blur-sm transition-colors hover:bg-base-100"
              style={`width: ${getCardWidth(logo.image)}px;`}
            >
              <Image
                src={logo.image}
                alt={logo.alt}
                class="client-logo h-auto max-h-14 w-auto max-w-[260px] object-contain opacity-85 transition-opacity duration-300 hover:opacity-100"
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- Row 2: Left to Right (order 30...1) -->
    <div class="marquee-group group flex w-max transition-opacity duration-500 hover:opacity-100">
      <div
        class="marquee-track flex shrink-0 items-center gap-4 pr-4"
        data-direction="right"
      >
        {
          reversedLogos.map((logo) => (
            <div
              class="flex h-[90px] shrink-0 items-center justify-center rounded-xl border-2 border-primary bg-base-100/50 py-3 px-2 shadow-sm backdrop-blur-sm transition-colors hover:bg-base-100"
              style={`width: ${getCardWidth(logo.image)}px;`}
            >
              <Image
                src={logo.image}
                alt={logo.alt}
                class="client-logo h-auto max-h-14 w-auto max-w-[260px] object-contain opacity-85 transition-opacity duration-300 hover:opacity-100"
              />
            </div>
          ))
        }
      </div>
      <!-- Duplicate list for seamless infinite scroll -->
      <div
        class="marquee-track flex shrink-0 items-center gap-4 pr-4"
        data-direction="right"
        aria-hidden="true"
      >
        {
          reversedLogos.map((logo) => (
            <div
              class="flex h-[90px] shrink-0 items-center justify-center rounded-xl border-2 border-primary bg-base-100/50 py-3 px-2 shadow-sm backdrop-blur-sm transition-colors hover:bg-base-100"
              style={`width: ${getCardWidth(logo.image)}px;`}
            >
              <Image
                src={logo.image}
                alt={logo.alt}
                class="client-logo h-auto max-h-14 w-auto max-w-[260px] object-contain opacity-85 transition-opacity duration-300 hover:opacity-100"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  function setupClientsMarquees() {
    const groups = document.querySelectorAll('.marquee-group');

    groups.forEach((group) => {
      const tracks = group.querySelectorAll('.marquee-track');
      if (!tracks.length) return;

      const firstTrack = tracks[0] as HTMLElement;
      // Get the width of one single track copy
      const trackWidth = firstTrack.offsetWidth;
      if (!trackWidth) return;

      // Target constant speed: 80 pixels per second
      const speed = 80;
      const duration = (trackWidth / speed) * 1000; // in milliseconds

      const animations: Animation[] = [];

      tracks.forEach((track) => {
        const direction = track.getAttribute('data-direction');
        const keyframes = direction === 'right'
          ? [{ transform: 'translateX(-100%)' }, { transform: 'translateX(0)' }]
          : [{ transform: 'translateX(0)' }, { transform: 'translateX(-100%)' }];

        const animation = track.animate(keyframes, {
          duration: duration,
          iterations: Infinity,
          easing: 'linear'
        });

        animations.push(animation);
      });

      // Mouse events on the parent group container for slowing down
      const onMouseEnter = () => {
        animations.forEach((anim) => {
          anim.playbackRate = 0.35; // Slow down to 35% speed
        });
      };

      const onMouseLeave = () => {
        animations.forEach((anim) => {
          anim.playbackRate = 1.0; // Return to full speed
        });
      };

      group.addEventListener('mouseenter', onMouseEnter);
      group.addEventListener('mouseleave', onMouseLeave);

      // Store cleanup function on the element for View Transitions
      (group as any)._marqueeCleanup = () => {
        group.removeEventListener('mouseenter', onMouseEnter);
        group.removeEventListener('mouseleave', onMouseLeave);
        animations.forEach((anim) => anim.cancel());
      };
    });
  }

  // Set up on page load (handles initial render and View Transitions)
  document.addEventListener('astro:page-load', setupClientsMarquees);

  // Clean up before swap to prevent memory leaks
  document.addEventListener('astro:before-swap', () => {
    const groups = document.querySelectorAll('.marquee-group');
    groups.forEach((group) => {
      if ((group as any)._marqueeCleanup) {
        (group as any)._marqueeCleanup();
      }
    });
  }, { once: true });
</script>
