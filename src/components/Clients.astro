---
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';

import logoHartron from '~/assets/logo-hartron.png';
import logoAiims from '~/assets/logo-aiims.png';
import logoAirtel from '~/assets/logo-airtel.png';
import logoCeasefire from '~/assets/logo-ceasefire-industries.jpeg';
import logoCisco from '~/assets/logo-cisco.png';
import logoDda from '~/assets/logo-dda.png';
import logoDgtahc from '~/assets/logo-dgtahc.jpg';
import logoDite from '~/assets/logo-dite.jpeg';
import logoFccb from '~/assets/logo-fccb.png';
import logoGmrl from '~/assets/logo-gmrl.png';
import logoHpgic from '~/assets/logo-hpgic.jpg';
import logoHpsedc from '~/assets/logo-hpsedc.png';
import logoHpsldc from '~/assets/logo-hpsldc.jpg';
import logoHvpn from '~/assets/logo-hvpn.jpeg';
import logoImmacule from '~/assets/logo-immacule-lifesciences.png';
import logoIndusTowers from '~/assets/logo-indus-towers.jpeg';
import logoKuantum from '~/assets/logo-kuantum_papers.jpeg';
import logoLovely from '~/assets/logo-lovely-international-trust.jpeg';
import logoNewIndia from '~/assets/logo-new-India-assurance.png';
import logoPunjabCourt from '~/assets/logo-punjab_and_haryana_high_court_logo.png';
import logoRadisys from '~/assets/logo-radisys-india.jpeg';
import logoReliance from '~/assets/logo-reliance-industries-limited.png';
import logoRhef from '~/assets/logo-rhef.png';
import logoRoparBank from '~/assets/logo-ropar-central-cooperative-bank.png';
import logoSangrurBank from '~/assets/logo-SANGRUR-CENTRAL-COOPERATIVE-BANK.jpeg';
import logoSupreme from '~/assets/logo-supreme-industries.jpeg';
import logoTechMahindra from '~/assets/logo-tech-mahindra.jpg';
import logoThapar from '~/assets/logo-thapar-institute-of-engineering-&-technology.png';
import logoUjvn from '~/assets/logo-UJVN.png';
import logoVodafone from '~/assets/logo-vodafone-Idea.png';

const clients = [
  { img: logoHartron, label: 'Hartron' },
  { img: logoAiims, label: 'AIIMS' },
  { img: logoAirtel, label: 'Airtel' },
  { img: logoCeasefire, label: 'Ceasefire Industries' },
  { img: logoCisco, label: 'Cisco' },
  { img: logoDda, label: 'DDA' },
  { img: logoDgtahc, label: 'Directorate General of Training' },
  { img: logoDite, label: 'DITE' },
  { img: logoFccb, label: 'FCCB' },
  { img: logoGmrl, label: 'GMRL' },
  { img: logoHpgic, label: 'HPGIC' },
  { img: logoHpsedc, label: 'HPSEDC' },
  { img: logoHpsldc, label: 'HPSLDC' },
  { img: logoHvpn, label: 'HVPN' },
  { img: logoImmacule, label: 'Immacule Lifesciences' },
  { img: logoIndusTowers, label: 'Indus Towers' },
  { img: logoKuantum, label: 'Kuantum Papers' },
  { img: logoLovely, label: 'Lovely International Trust' },
  { img: logoNewIndia, label: 'New India Assurance' },
  { img: logoPunjabCourt, label: 'Punjab & Haryana High Court' },
  { img: logoRadisys, label: 'Radisys India' },
  { img: logoReliance, label: 'Reliance Industries Limited' },
  { img: logoRhef, label: 'RHEF' },
  { img: logoRoparBank, label: 'Ropar Central Cooperative Bank' },
  { img: logoSangrurBank, label: 'Sangrur Central Cooperative Bank' },
  { img: logoSupreme, label: 'Supreme Industries' },
  { img: logoTechMahindra, label: 'Tech Mahindra' },
  { img: logoThapar, label: 'Thapar Institute' },
  { img: logoUjvn, label: 'UJVN' },
  { img: logoVodafone, label: 'Vodafone Idea' },
];

const reversedClients = [...clients].reverse();

// Helper to calculate elegant dynamic card width based on aspect ratio
function getCardWidth(img: any) {
  const aspectRatio = img.width / img.height;
  const targetLogoHeight = 56; // max-h-14 is 56px
  const calculatedWidth = Math.round(targetLogoHeight * aspectRatio) + 16;
  return Math.max(60, Math.min(300, calculatedWidth));
}
---

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-100%);
    }
  }
  @keyframes marquee-reverse {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(0%);
    }
  }
  .animate-marquee {
    animation: marquee 60s linear infinite;
  }
  .animate-marquee-reverse {
    animation: marquee-reverse 60s linear infinite;
  }


</style>

<section class="relative mx-auto max-w-6xl overflow-hidden px-4 pb-24">
  <div class="mb-10 flex items-center justify-between">
    <h2 class="text-3xl font-bold text-base-content md:text-5xl">
      Some of our valuable Clients
    </h2>
    <a
      href="#contact"
      aria-label="Contact Us"
      class="flex h-12 w-12 shrink-0 cursor-pointer items-center justify-center rounded-full border border-primary text-primary transition-colors hover:bg-primary hover:text-primary-content"
    >
      <ArrowRight class="h-6 w-6" />
    </a>
  </div>

  <!-- Marquee Wrapper with Fade -->
  <div
    class="flex w-full flex-col gap-4 mask-[linear-gradient(to_right,transparent_0,black_128px,black_calc(100%-128px),transparent_100%)]"
  >
    <!-- Row 1: Right to Left (order 1...30) -->
    <div class="group flex w-max transition-opacity duration-500 hover:opacity-100">
      <div
        class="animate-marquee flex shrink-0 items-center gap-4 pr-4 group-hover:[animation-play-state:paused]"
      >
        {
          clients.map((logo) => (
            <div
              class="flex h-[90px] shrink-0 items-center justify-center rounded-xl border-2 border-primary bg-base-100/50 py-3 px-2 shadow-sm backdrop-blur-sm transition-colors hover:bg-base-100"
              style={`width: ${getCardWidth(logo.img)}px;`}
            >
              <Image
                src={logo.img}
                alt={logo.label}
                class="client-logo h-auto max-h-14 w-auto max-w-[260px] object-contain opacity-85 transition-opacity duration-300 hover:opacity-100"
              />
            </div>
          ))
        }
      </div>
      <!-- Duplicate list for seamless infinite scroll -->
      <div
        class="animate-marquee flex shrink-0 items-center gap-4 pr-4 group-hover:[animation-play-state:paused]"
        aria-hidden="true"
      >
        {
          clients.map((logo) => (
            <div
              class="flex h-[90px] shrink-0 items-center justify-center rounded-xl border-2 border-primary bg-base-100/50 py-3 px-2 shadow-sm backdrop-blur-sm transition-colors hover:bg-base-100"
              style={`width: ${getCardWidth(logo.img)}px;`}
            >
              <Image
                src={logo.img}
                alt={logo.label}
                class="client-logo h-auto max-h-14 w-auto max-w-[260px] object-contain opacity-85 transition-opacity duration-300 hover:opacity-100"
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- Row 2: Left to Right (order 30...1) -->
    <div class="group flex w-max transition-opacity duration-500 hover:opacity-100">
      <div
        class="animate-marquee-reverse flex shrink-0 items-center gap-4 pr-4 group-hover:[animation-play-state:paused]"
      >
        {
          reversedClients.map((logo) => (
            <div
              class="flex h-[90px] shrink-0 items-center justify-center rounded-xl border-2 border-primary bg-base-100/50 py-3 px-2 shadow-sm backdrop-blur-sm transition-colors hover:bg-base-100"
              style={`width: ${getCardWidth(logo.img)}px;`}
            >
              <Image
                src={logo.img}
                alt={logo.label}
                class="client-logo h-auto max-h-14 w-auto max-w-[260px] object-contain opacity-85 transition-opacity duration-300 hover:opacity-100"
              />
            </div>
          ))
        }
      </div>
      <!-- Duplicate list for seamless infinite scroll -->
      <div
        class="animate-marquee-reverse flex shrink-0 items-center gap-4 pr-4 group-hover:[animation-play-state:paused]"
        aria-hidden="true"
      >
        {
          reversedClients.map((logo) => (
            <div
              class="flex h-[90px] shrink-0 items-center justify-center rounded-xl border-2 border-primary bg-base-100/50 py-3 px-2 shadow-sm backdrop-blur-sm transition-colors hover:bg-base-100"
              style={`width: ${getCardWidth(logo.img)}px;`}
            >
              <Image
                src={logo.img}
                alt={logo.label}
                class="client-logo h-auto max-h-14 w-auto max-w-[260px] object-contain opacity-85 transition-opacity duration-300 hover:opacity-100"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
