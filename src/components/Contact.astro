---
import { Image } from 'astro:assets';
import customerSupportImg from '~/assets/customer-support-img.svg';
---

<section id="contact" class="relative z-20 mx-auto max-w-6xl scroll-mt-48 px-4">
  <div
    class="flex flex-col rounded-t-3xl bg-[#2a453d] p-6 shadow-xl md:flex-row md:rounded-3xl md:px-10 md:py-6"
  >
    <!-- Image Side -->
    <div
      class="relative flex min-h-[220px] items-end justify-center md:min-h-full md:w-5/12 md:justify-start"
    >
      <Image
        src={customerSupportImg}
        alt="Customer Support"
        class="absolute -bottom-6 z-10 h-auto w-[90%] max-w-[400px] object-contain md:-bottom-6 md:-left-8 md:w-[140%] md:max-w-[600px] lg:-left-12 lg:w-[150%]"
      />
    </div>

    <!-- Form Side -->
    <div class="z-20 mt-48 pt-4 md:mt-0 md:w-7/12 md:pt-0">
      <h2 class="mb-6 text-2xl font-bold text-white md:text-[28px] md:leading-tight">
        Have a question or need assistance? Send us a message.
      </h2>

      <form id="contact-form" class="space-y-3">
        <div class="flex flex-col gap-4 md:flex-row">
          <input
            type="text"
            name="fullName"
            placeholder="Full Name"
            aria-label="Full Name"
            required
            class="input-bordered input h-10 w-full border-white/30 bg-transparent text-white placeholder:text-white/50 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none"
          />
          <input
            type="email"
            name="email"
            placeholder="Email"
            aria-label="Email Address"
            required
            class="input-bordered input h-10 w-full border-white/30 bg-transparent text-white placeholder:text-white/50 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none"
          />
        </div>

        <input
          type="text"
          name="category"
          placeholder="Category"
          aria-label="Category"
          class="input-bordered input h-10 w-full border-white/30 bg-transparent text-white placeholder:text-white/50 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none"
        />

        <textarea
          name="message"
          required
          class="textarea-bordered textarea h-20 w-full border-white/30 bg-transparent text-white placeholder:text-white/50 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none"
          aria-label="Your Message"
          placeholder="Your Message"></textarea>

        <button
          type="submit"
          class="btn mx-auto mt-2 flex w-full rounded border-none bg-[#00B970] font-bold text-white btn-primary hover:bg-primary/90 md:w-2/3"
        >
          Submit
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();

      // Grab the form data to be ready for the API call
      const formData = new FormData(e.target as HTMLFormElement);
      const data = Object.fromEntries(formData);
      console.log('Form data ready for submission:', data);

      // TODO: Add logic here to submit the form data using fetch() or similar
    });
  }

  document.addEventListener('astro:page-load', setupContactForm);
</script>
