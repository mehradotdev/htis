---
import { Image } from 'astro:assets';
import img1 from '../assets/our-journey-1.png';
import img2 from '../assets/our-journey-2.png';
import img3 from '../assets/our-journey-3.png';
import img4 from '../assets/our-journey-4.png';
import img5 from '../assets/our-journey-5.png';
import img6 from '../assets/our-journey-6.png';
import img7 from '../assets/our-journey-7.png';
import img8 from '../assets/our-journey-8.png';
import img9 from '../assets/our-journey-9.png';

const milestones = [
  {
    year: '2003',
    title: 'Kickstarted',
    description:
      'HTIS was founded with a vision to revolutionize the telecommunications and IT services sector.',
    image: img1,
  },
  {
    year: '2004',
    title: 'First Venture',
    description:
      'Secured our first enterprise partnership, setting the standard for our commitment to excellence.',
    image: img2,
  },
  {
    year: '2005',
    title: 'Expansion',
    description:
      'Expanded operations across multiple regions, growing our team to meet increasing market demand.',
    image: img3,
  },
  {
    year: '2007',
    title: 'Diversified',
    description:
      'Introduced comprehensive manpower solutions to our portfolio, offering end-to-end support.',
    image: img4,
  },
  {
    year: '2012',
    title: 'Tech Leap',
    description:
      'Adopted cutting-edge enterprise technologies, enabling faster and more scalable service delivery.',
    image: img5,
  },
  {
    year: '2015',
    title: 'First Award',
    description:
      'Received our first major industry award for outstanding service and innovation in telecom.',
    image: img6,
  },
  {
    year: '2020',
    title: 'Resilience',
    description:
      'Successfully navigated global challenges, transitioning to robust remote operations.',
    image: img7,
  },
  {
    year: '2023',
    title: 'Alliances',
    description:
      'Forged key strategic alliances with global tech leaders, expanding our capabilities and reach.',
    image: img8,
  },
  {
    year: '2024',
    title: 'Next-Gen',
    description:
      'Pioneering AI-driven telecom and workforce solutions for the digital-first future.',
    image: img9,
  },
];
---

<section
  class="relative mx-auto max-w-7xl overflow-hidden px-4 py-24"
  id="journey-section"
>
  <!-- Subtle grid background -->
  <div
    class="absolute inset-0 z-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNDAiIGhlaWdodD0iNDAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+CjxwYXRoIGQ9Ik0wIDBoNDB2NDBIMHoiIGZpbGw9Im5vbmUiLz4KPHBhdGggZD0iTTAgMGg0MHYxbC00MCAuMDAxem0wIDM5LjAwMWg0MHYxSC4wMDF6bTM5LjAwMS0zOS4wMDFoMXY0MGgtMXpNMCAwaDF2NDBIMHoiIGZpbGw9InJnYmEoMCwgMCwgMCwgMC4wNSkiLz4KPC9zdmc+')] opacity-50"
  >
  </div>

  <div class="relative z-10 flex flex-col items-center">
    <!-- Slide Area -->
    <div class="relative mx-auto mt-10 w-full max-w-5xl" aria-live="polite">
      <!-- Static decorative text perfectly aligned to image bounds -->
      <!-- 'pointer-events-none' ensures clicks pass through to slides/images -->
      <!-- 'mt-16 md:mt-24' exactly matches the margin of the slide image box below -->
      <div
        class="pointer-events-none absolute inset-x-0 top-0 z-40 mx-auto mt-16 h-0 w-[90%] md:mt-24 md:w-[75%]"
      >
        <!-- '-right-2' pins it to the edge, 'translate-x-1/2' pushes it so it straddles the edge exacty -->
        <!-- Using standard margins/inset instead of translates to avoid sub-pixel jitter -->
        <div class="absolute top-0 -right-2 translate-x-1/2">
          <div class="relative">
            <!-- 'Our' placed just above the image edge, slightly shifted left of the vertical text -->
            <div
              class="absolute right-[30%] bottom-[90%] text-5xl leading-none font-extrabold tracking-tight text-[#2a453d] drop-shadow-[0_2px_4px_rgba(255,255,255,0.8)] md:text-[80px]"
            >
              Our
            </div>
            <!-- 'Journey' overlaps the image vertically downwards -->
            <div
              class="translate-y-4 text-5xl font-extrabold tracking-tight text-primary drop-shadow-[0_2px_4px_rgba(255,255,255,0.8)] md:text-[80px]"
              style="writing-mode: vertical-rl;"
            >
              Journey
            </div>
          </div>
        </div>
      </div>

      <!-- Slides -->
      {
        milestones.map((milestone, index) => (
          <div class={`journey-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
            {/* Container to establish positioning context aligned perfectly with the image */}
            <div class="relative mx-auto mt-16 mb-28 w-[90%] md:mt-24 md:mb-32 md:w-[75%]">
              {/* Main Image (No rounded corners, to mimic the sharp look in the reference) */}
              <div class="image-box relative z-20 aspect-[4/3] w-full overflow-hidden bg-base-200 shadow-xl md:aspect-[16/9]">
                <Image
                  src={milestone.image}
                  alt={`HTIS journey in ${milestone.year}: ${milestone.title}`}
                  class="absolute inset-0 h-full w-full object-cover"
                  loading={index < 2 ? 'eager' : 'lazy'}
                />
                <div class="pointer-events-none absolute inset-0 bg-white/10 mix-blend-overlay" />
                {/* Gradient for the Year (Top Left) */}
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white/80 via-transparent to-transparent opacity-80" />
                {/* Gradient for the Title & Desc (Bottom Left) */}
                <div class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-white/80 via-transparent to-transparent opacity-80" />
              </div>

              {/* Year (Overlap Top Left) */}
              <div class="year-text absolute -top-10 -left-6 z-30 text-6xl leading-none font-extrabold tracking-tight text-[#2a453d] drop-shadow-md md:-top-16 md:-left-12 md:text-[110px]">
                {milestone.year}
              </div>

              {/* Title & Description (Overlap Bottom Left) */}
              <div class="slide-info absolute -bottom-16 -left-2 z-30 max-w-sm md:-bottom-20 md:-left-12 md:max-w-lg">
                <h3 class="title-text text-5xl leading-none font-extrabold tracking-tight text-[#2a453d] drop-shadow-md md:text-[80px]">
                  {milestone.title}
                </h3>
                <p class="desc-box mt-2 ml-1 text-sm leading-relaxed font-medium text-[#2a453d]/80 md:mt-4 md:text-lg">
                  {milestone.description}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Timeline Navigation -->
    <div class="relative mt-16 w-full max-w-5xl md:mt-20">
      <div
        class="hide-scrollbar relative flex items-end justify-between overflow-x-auto pt-10 pb-4"
        role="tablist"
      >
        <!-- Connecting Line -->
        <div
          class="absolute right-0 bottom-[1.125rem] left-0 z-0 h-[2px] border-t-2 border-dashed border-primary/20"
        >
        </div>

        {
          milestones.map((milestone, index) => (
            <button
              class={`journey-timeline-btn relative z-10 flex min-w-[70px] cursor-pointer flex-col items-center transition-all duration-300 hover:opacity-100 md:min-w-[80px] ${index === 0 ? 'active opacity-100' : 'opacity-50'}`}
              data-index={index}
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-label={`View milestone: ${milestone.year} — ${milestone.title}`}
            >
              <div class="timeline-year mb-1 transition-all duration-300">
                {milestone.year}
              </div>
              <div class="timeline-label mb-2 px-1 text-center transition-all duration-300">
                {milestone.title}
              </div>
              <div class="timeline-indicator w-[3px] rounded-full bg-primary transition-all duration-500 ease-out" />
            </button>
          ))
        }
      </div>

      <!-- Small dots for timeline spacing (visual only) -->
      <div
        class="pointer-events-none absolute bottom-[1.12rem] left-0 hidden w-full justify-between px-[40px] md:flex"
      >
        {
          Array.from({ length: 40 }).map((_) => (
            <div class="h-1.5 w-1.5 rounded-full bg-primary/20" />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Scrollbar hiding */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* ── Slide layout ── */
  .journey-slide {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* Stacked via absolute so only the active one takes space */
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    z-index: 0;
    transition: opacity 0.8s ease;
  }
  .journey-slide.active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
    z-index: 10;
  }

  /* ── Slide element entrance animations ── */
  .journey-slide .year-text {
    transform: translateY(-20px);
    opacity: 0;
    transition:
      transform 1s cubic-bezier(0.16, 1, 0.3, 1) 0.05s,
      opacity 0.8s ease 0.05s;
  }
  .journey-slide.active .year-text {
    transform: translateY(0);
    opacity: 0.9;
  }

  .journey-slide .image-box {
    transform: scale(0.96) translateY(12px);
    opacity: 0;
    transition:
      transform 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.1s,
      opacity 0.7s ease 0.1s;
  }
  .journey-slide.active .image-box {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .journey-slide .title-text {
    transform: translateX(-25px);
    opacity: 0;
    transition:
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.25s,
      opacity 0.6s ease 0.25s;
  }
  .journey-slide.active .title-text {
    transform: translateX(0);
    opacity: 1;
  }

  .journey-slide .desc-box {
    transform: translateY(15px);
    opacity: 0;
    transition:
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s,
      opacity 0.6s ease 0.4s;
  }
  .journey-slide.active .desc-box {
    transform: translateY(0);
    opacity: 1;
  }

  /* ── Timeline button styles (inactive) ── */
  .journey-timeline-btn {
    height: 100px; /* Fixed height for ticker items to prevent vertical shifts */
  }
  .journey-timeline-btn .timeline-year {
    font-size: 11px;
    color: oklch(var(--bc) / 0.45);
    font-weight: 500;
  }
  .journey-timeline-btn .timeline-label {
    font-size: 10px;
    color: oklch(var(--bc) / 0.45);
    font-weight: 500;
  }
  .journey-timeline-btn .timeline-indicator {
    height: 12px;
    opacity: 0.35;
    margin-top: 10px;
  }

  /* ── Timeline button styles (active) ── */
  .journey-timeline-btn.active .timeline-year {
    font-size: 13px;
    color: #2a453d;
    font-weight: 800;
    transform: translateY(-2px);
  }
  .journey-timeline-btn.active .timeline-label {
    font-size: 12px;
    color: #2a453d;
    font-weight: 700;
    transform: translateY(-2px);
  }
  .journey-timeline-btn.active .timeline-indicator {
    height: 32px;
    opacity: 1;
    margin-top: 0;
    box-shadow: 0 0 10px rgba(42, 69, 61, 0.25);
  }
</style>

<script>
  (function initJourneyCarousel() {
    // Guard: prevent duplicate setup from multiple event hooks
    const section = document.getElementById('journey-section');
    if (!section) return;
    if (section.dataset.carouselInit === 'true') return;
    section.dataset.carouselInit = 'true';

    const slides = section.querySelectorAll<HTMLElement>('.journey-slide');
    const buttons = section.querySelectorAll<HTMLElement>('.journey-timeline-btn');
    if (!slides.length || !buttons.length) return;

    let currentIndex = 0;
    const totalSlides = slides.length;
    let intervalId: ReturnType<typeof setInterval> | undefined;
    const INTERVAL_MS = 3000; // auto-switch every 3 seconds

    function goToSlide(index: number) {
      // Deactivate all slides and buttons
      slides.forEach((s) => s.classList.remove('active'));
      buttons.forEach((b) => {
        b.classList.remove('active', 'opacity-100');
        b.classList.add('opacity-50');
        b.setAttribute('aria-selected', 'false');
      });

      // Activate the target
      currentIndex = index;
      slides[currentIndex].classList.add('active');
      buttons[currentIndex].classList.add('active', 'opacity-100');
      buttons[currentIndex].classList.remove('opacity-50');
      buttons[currentIndex].setAttribute('aria-selected', 'true');

      // Horizontally scroll the timeline strip so the active button is centered.
      // We deliberately avoid scrollIntoView() because it also scrolls ancestor
      // containers (the page), which causes unwanted vertical page jumps.
      const timeline = buttons[currentIndex].closest('.hide-scrollbar');
      if (timeline) {
        const btnRect = buttons[currentIndex].getBoundingClientRect();
        const timelineRect = timeline.getBoundingClientRect();
        const scrollLeft =
          timeline.scrollLeft +
          (btnRect.left - timelineRect.left) -
          (timelineRect.width - btnRect.width) / 2;
        timeline.scrollTo({ left: scrollLeft, behavior: 'smooth' });
      }
    }

    function nextSlide() {
      goToSlide((currentIndex + 1) % totalSlides);
    }

    function startAutoPlay() {
      stopAutoPlay();
      intervalId = setInterval(nextSlide, INTERVAL_MS);
    }

    function stopAutoPlay() {
      if (intervalId !== undefined) {
        clearInterval(intervalId);
        intervalId = undefined;
      }
    }

    // Manual click on timeline buttons
    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        goToSlide(i);
        // Reset auto-play so user gets a full interval before the next switch
        startAutoPlay();
      });
    });

    // Start auto-play
    startAutoPlay();

    // Cleanup on Astro View Transitions (if ever enabled)
    document.addEventListener(
      'astro:before-swap',
      () => {
        stopAutoPlay();
        section.dataset.carouselInit = 'false';
      },
      { once: true },
    );
  })();
</script>
