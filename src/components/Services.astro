---
import ArrowTopRightIcon from './icons/ArrowTopRightIcon.astro';
import WifiIcon from './icons/WifiIcon.astro';
import ShieldCheckIcon from './icons/ShieldCheckIcon.astro';
import GlobeAltIcon from './icons/GlobeAltIcon.astro';
import WrenchScrewdriverIcon from './icons/WrenchScrewdriverIcon.astro';
import CogIcon from './icons/CogIcon.astro';
import ServerIcon from './icons/ServerIcon.astro';
import UserGroupIcon from './icons/UserGroupIcon.astro';
import ClockIcon from './icons/ClockIcon.astro';
import MagnifyingGlassIcon from './icons/MagnifyingGlassIcon.astro';
import ClipboardDocumentIcon from './icons/ClipboardDocumentIcon.astro';
import ChartBarIcon from './icons/ChartBarIcon.astro';
import UsersIcon from './icons/UsersIcon.astro';
import ArrowRightIcon from './icons/ArrowRightIcon.astro';
---

<section class="relative mx-auto max-w-7xl px-4 py-20">
  <div
    class="flex flex-col gap-0 overflow-hidden rounded-lg border border-base-content/10 bg-base-200/30 shadow-sm lg:flex-row"
  >
    <!-- Left SIDE -->
    <div
      class="relative flex items-center border-r border-base-content/10 bg-linear-to-br from-teal-50/80 to-teal-100/30 p-10 md:p-14 lg:w-1/3"
    >
      <div
        class="absolute inset-0 z-0 bg-[url('/src/assets/our-services-bg.png')] bg-cover opacity-40 mix-blend-multiply"
      >
      </div>
      <h2
        class="relative z-10 flex flex-col text-5xl leading-tight font-bold text-[#2a453d] md:text-6xl"
      >
        <span>Our</span>
        <span>Services</span>
      </h2>
    </div>

    <!-- Right SIDE -->
    <div
      id="services-right-grid"
      class="group relative flex flex-col overflow-hidden bg-base-200/30 transition-all duration-700 md:block md:h-[530px] md:overflow-visible md:bg-transparent lg:w-2/3"
    >
      <!-- Block 1: Telecom Title -->
      <div
        class="relative z-10 flex w-full flex-col border-b border-base-content/10 transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] md:absolute md:top-0 md:left-0 md:h-[140px] md:w-[50%] md:border-r md:bg-base-200/90 md:backdrop-blur-md"
      >
        <div class="flex h-full w-full items-center justify-between p-6 md:p-8">
          <h3 class="text-xl font-bold text-base-content/80 md:text-2xl">
            Telecommunications
          </h3>
          <div
            class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border border-primary bg-primary/10 text-primary"
          >
            <ArrowTopRightIcon class="h-4 w-4" />
          </div>
        </div>
      </div>

      <!-- Block 2: 6 Icons Drawer (Crossfades content based on state) -->
      <div
        id="icons-block"
        class="relative z-10 w-full overflow-hidden border-b border-base-content/10 transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] md:absolute md:top-[140px] md:left-0 md:h-[250px] md:w-[50%] md:border-r md:bg-base-200/90 md:backdrop-blur-md group-[.is-manpower-hovered]:md:top-[280px] group-[.is-manpower-hovered]:md:left-[25%]"
      >
        <!-- Telecom Icons (Visible in State 1) -->
        <div
          class="pointer-events-auto absolute inset-0 grid grid-cols-3 grid-rows-2 opacity-100 transition-opacity duration-700 group-[.is-manpower-hovered]:pointer-events-none group-[.is-manpower-hovered]:opacity-0"
        >
          <div
            class="flex flex-col items-center justify-center border-r border-b border-base-content/10 p-4 text-center"
          >
            <WifiIcon class="mb-2 h-8 w-8 text-primary" />
            <span class="text-xs font-medium text-base-content/70"
              >Wireless<br />Solutions</span
            >
          </div>
          <div
            class="flex flex-col items-center justify-center border-r border-b border-base-content/10 p-4 text-center"
          >
            <ShieldCheckIcon class="mb-2 h-8 w-8 text-primary" />
            <span class="text-xs font-medium text-base-content/70"
              >Network<br />Security</span
            >
          </div>
          <div
            class="flex flex-col items-center justify-center border-b border-base-content/10 p-4 text-center"
          >
            <GlobeAltIcon class="mb-2 h-8 w-8 text-primary" />
            <span class="text-xs font-medium text-base-content/70"
              >Fiber<br />Deployment</span
            >
          </div>
          <div
            class="flex flex-col items-center justify-center border-r border-base-content/10 p-4 text-center"
          >
            <WrenchScrewdriverIcon class="mb-2 h-8 w-8 text-primary" />
            <span class="text-xs font-medium text-base-content/70"
              >RF<br />Engineering</span
            >
          </div>
          <div
            class="flex flex-col items-center justify-center border-r border-base-content/10 p-4 text-center"
          >
            <CogIcon class="mb-2 h-8 w-8 text-primary" />
            <span class="text-xs font-medium text-base-content/70">AMC<br />Support</span>
          </div>
          <div
            class="flex flex-col items-center justify-center border-base-content/10 p-4 text-center"
          >
            <ServerIcon class="mb-2 h-8 w-8 text-primary" />
            <span class="text-xs font-medium text-base-content/70"
              >Telecom<br />Maintenance</span
            >
          </div>
        </div>

        <!-- Manpower Icons (Visible in State 2) -->
        <div
          class="pointer-events-none absolute inset-0 grid grid-cols-3 grid-rows-2 opacity-0 transition-opacity duration-700 group-[.is-manpower-hovered]:pointer-events-auto group-[.is-manpower-hovered]:opacity-100"
        >
          <div
            class="flex flex-col items-center justify-center border-r border-b border-base-content/10 p-4 text-center"
          >
            <UserGroupIcon class="mb-2 h-8 w-8 text-primary" />
            <span class="text-xs font-medium text-base-content/70"
              >IT Staff<br />Augmentation</span
            >
          </div>
          <div
            class="flex flex-col items-center justify-center border-r border-b border-base-content/10 p-4 text-center"
          >
            <ClockIcon class="mb-2 h-8 w-8 text-primary" />
            <span class="text-xs font-medium text-base-content/70"
              >Temporary<br />Hiring</span
            >
          </div>
          <div
            class="flex flex-col items-center justify-center border-b border-base-content/10 p-4 text-center"
          >
            <MagnifyingGlassIcon class="mb-2 h-8 w-8 text-primary" />
            <span class="text-xs font-medium text-base-content/70"
              >Executive<br />Search</span
            >
          </div>
          <div
            class="flex flex-col items-center justify-center border-r border-base-content/10 p-4 text-center"
          >
            <ClipboardDocumentIcon class="mb-2 h-8 w-8 text-primary" />
            <span class="text-xs font-medium text-base-content/70"
              >Contract to<br />Hire</span
            >
          </div>
          <div
            class="flex flex-col items-center justify-center border-r border-base-content/10 p-4 text-center"
          >
            <ChartBarIcon class="mb-2 h-8 w-8 text-primary" />
            <span class="text-xs font-medium text-base-content/70"
              >Payroll<br />Management</span
            >
          </div>
          <div
            class="flex flex-col items-center justify-center border-base-content/10 p-4 text-center"
          >
            <UsersIcon class="mb-2 h-8 w-8 text-primary" />
            <span class="text-xs font-medium text-base-content/70"
              >Project<br />Teams</span
            >
          </div>
        </div>
      </div>

      <!-- Block 3: Stats Box -->
      <div
        class="relative z-10 flex w-full flex-col border-b border-base-content/10 bg-base-100/50 transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] md:absolute md:top-0 md:left-[50%] md:h-[390px] md:w-[25%] md:border-r md:bg-base-100/90 md:backdrop-blur-md group-[.is-manpower-hovered]:md:top-[140px] group-[.is-manpower-hovered]:md:left-[75%]"
      >
        <div
          class="flex flex-1 flex-col items-center justify-center space-y-1 border-b border-base-content/10 p-4 text-center"
        >
          <span class="text-2xl font-bold text-primary">100+</span>
          <span class="text-xs font-medium text-base-content/70"
            >Network<br />Deployment</span
          >
        </div>
        <div
          class="flex flex-1 flex-col items-center justify-center space-y-1 border-b border-base-content/10 p-4 text-center"
        >
          <span class="text-2xl font-bold text-primary">11+</span>
          <span class="text-xs font-medium text-base-content/70"
            >Years of<br />Exprirence</span
          >
        </div>
        <div
          class="flex flex-1 flex-col items-center justify-center space-y-1 border-b border-base-content/10 p-4 text-center"
        >
          <span class="text-2xl font-bold text-primary">91+</span>
          <span class="text-xs font-medium text-base-content/70"
            >Enterprise<br />Clients</span
          >
        </div>
        <div
          class="flex flex-1 flex-col items-center justify-center space-y-1 p-4 text-center"
        >
          <span class="text-2xl font-bold text-primary">99%</span>
          <span class="text-xs font-medium text-base-content/70">Uptime</span>
        </div>
      </div>

      <!-- Block 4: Software Development -->
      <div
        class="relative z-10 flex w-full flex-col items-center justify-center border-b border-base-content/10 p-6 text-center transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] md:absolute md:top-0 md:left-[75%] md:h-[390px] md:w-[25%] md:bg-base-200/90 md:p-8 md:backdrop-blur-md group-[.is-manpower-hovered]:md:left-[50%] group-[.is-manpower-hovered]:md:h-[140px] group-[.is-manpower-hovered]:md:w-[50%]"
      >
        <div
          class="absolute top-4 right-4 flex h-8 w-8 items-center justify-center rounded-full border border-primary bg-primary/10 text-primary"
        >
          <ArrowTopRightIcon class="h-4 w-4" />
        </div>
        <h3
          class="mt-8 text-xl font-bold text-base-content/80 transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] md:text-2xl group-[.is-manpower-hovered]:md:mt-0"
        >
          Software<br class="hidden md:block group-[.is-manpower-hovered]:md:hidden" /> Development
        </h3>
      </div>

      <!-- Block 5: System Integrations -->
      <div
        class="relative z-10 flex w-full flex-col items-center justify-center border-b border-base-content/10 bg-base-100/50 p-6 text-center transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] md:absolute md:top-[390px] md:left-0 md:h-[140px] md:w-[75%] md:flex-row md:border-r md:border-b-0 md:bg-base-100/90 md:p-8 md:backdrop-blur-md group-[.is-manpower-hovered]:md:top-[140px] group-[.is-manpower-hovered]:md:h-[390px] group-[.is-manpower-hovered]:md:w-[25%] group-[.is-manpower-hovered]:md:flex-col group-[.is-manpower-hovered]:md:justify-center"
      >
        <h3
          class="mt-8 text-xl font-bold text-base-content/80 transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] md:mt-0 md:text-2xl"
        >
          System<br class="hidden group-[.is-manpower-hovered]:md:block" /> Integrations
        </h3>
        <div
          class="absolute top-4 right-4 flex h-8 w-8 items-center justify-center rounded-full border border-primary bg-primary/10 text-primary"
        >
          <ArrowRightIcon class="h-4 w-4" />
        </div>
      </div>

      <!-- Block 6: Manpower Services -->
      <!-- Invisible Hotspot to prevent flickering when mouse stays at bottom right -->
      <div
        id="manpower-hotspot"
        class="absolute top-[390px] left-[75%] z-50 hidden h-[140px] w-[25%] md:block"
      >
      </div>

      <div
        id="manpower-trigger"
        class="relative z-10 flex w-full cursor-pointer items-center justify-center border-base-content/10 border-transparent p-6 text-center transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)] hover:bg-base-200/50 hover:shadow-lg md:absolute md:top-[390px] md:left-[75%] md:h-[140px] md:w-[25%] md:bg-base-200/90 md:p-8 md:backdrop-blur-md group-[.is-manpower-hovered]:md:top-[140px] group-[.is-manpower-hovered]:md:left-[25%] group-[.is-manpower-hovered]:md:h-[140px] group-[.is-manpower-hovered]:md:w-[50%] group-[.is-manpower-hovered]:md:border-r"
      >
        <h3 class="text-xl font-bold text-base-content/80">Manpower Services</h3>
        <div
          class="absolute top-4 right-4 flex h-8 w-8 items-center justify-center rounded-full border border-primary bg-primary/10 text-primary transition-transform group-[.is-manpower-hovered]:rotate-45"
        >
          <ArrowRightIcon class="h-4 w-4" />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupHover() {
    let hoverTimer: ReturnType<typeof setTimeout> | undefined;
    const trigger = document.getElementById('manpower-trigger');
    const icons = document.getElementById('icons-block');
    const hotspot = document.getElementById('manpower-hotspot');
    const container = document.getElementById('services-right-grid');

    if (!trigger || !container) return;

    const activators = [trigger, hotspot];
    const sustainers = [trigger, icons, hotspot];

    function handleState() {
      // Allow slight ms for mouse to travel between adjacent blocks without flickering
      clearTimeout(hoverTimer);
      hoverTimer = setTimeout(() => {
        const isHovering = sustainers.some((el) => el && el.matches(':hover'));
        if (isHovering) {
          container?.classList.add('is-manpower-hovered');
        } else {
          container?.classList.remove('is-manpower-hovered');
        }
      }, 50);
    }

    activators.forEach((el) => {
      if (el) {
        el.addEventListener('mouseenter', () => {
          clearTimeout(hoverTimer);
          container?.classList.add('is-manpower-hovered');
        });
      }
    });

    sustainers.forEach((el) => {
      if (el) {
        el.addEventListener('mouseleave', handleState);
      }
    });
  }

  document.addEventListener('astro:page-load', setupHover);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHover);
  } else {
    setupHover();
  }
</script>
