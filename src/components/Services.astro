---
import { Image } from 'astro:assets';
import ServicesGrid from './ServicesGrid.svelte';
import serviceBg from '~/assets/our-services-bg.png';
---

<section class="relative mx-auto max-w-7xl px-4 pt-28 pb-12 lg:pt-32 lg:pb-16">
  <div
    class="flex flex-col gap-0 overflow-hidden rounded-lg border border-base-content/30 bg-base-200/30 shadow-sm lg:flex-row"
  >
    <!-- Left SIDE -->
    <div
      class="relative flex items-start border-b border-base-content/30 bg-primary/30 p-10 md:p-14 lg:w-[40%] lg:border-r lg:border-b-0"
    >
      <Image
        src={serviceBg}
        alt="Services Background"
        class="absolute inset-0 z-0 h-full w-full object-cover opacity-70"
        style="filter: var(--filter-invert-dark)"
      />
      <h2
        class="relative z-10 flex flex-col text-5xl leading-tight font-bold text-base-content md:text-6xl"
      >
        <span>Our</span>
        <span>Services</span>
      </h2>
    </div>

    <!-- Right SIDE -->
    <ServicesGrid client:visible />
  </div>
</section>
