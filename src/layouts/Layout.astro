---
import { ClientRouter } from 'astro:transitions';
import '~/assets/app.css';
import WhatsAppButton from '~/components/WhatsAppButton.astro';

interface Props {
  title?: string;
}

const { title = 'HTIS - Delivering Excellence in System Integrations' } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="htis-theme" class="scroll-smooth">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      /**
       * Astro View Transitions (ClientRouter) theme persistence helper.
       * 
       * When navigating between pages using Astro's ClientRouter, the DOM is patched/swapped
       * without a full page reload. This process resets the `<html>` element's attributes
       * (like `data-theme`) to the default state defined in the next page's static HTML template.
       * 
       * To keep the theme persistent:
       * 1. `applyTheme()` reads and applies the theme from sessionStorage, defaulting to the OS
       *    color scheme preference (dark vs. light) if not yet set in the session.
       * 2. It runs synchronously on initial load to prevent Flash of Unstyled Theme (FOUT).
       * 3. It registers an `astro:after-swap` listener to re-apply the correct theme immediately
       *    after Astro swaps the DOM, before the new page renders and hydrates.
       */
      const applyTheme = () => {
        try {
          let savedTheme = sessionStorage.getItem('theme');
          if (!savedTheme) {
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            savedTheme = prefersDark ? 'htis-theme-dark' : 'htis-theme';
            sessionStorage.setItem('theme', savedTheme);
          }
          document.documentElement.setAttribute('data-theme', savedTheme);
        } catch (e) {
          console.error('SessionStorage access failed:', e);
        }
      };

      // Apply saved theme before first paint to avoid flash
      applyTheme();

      // Re-apply theme after Astro view transition swaps the page
      document.addEventListener('astro:after-swap', applyTheme);
      // Fallback: Re-apply theme after the page has fully loaded and hydrated
      document.addEventListener('astro:page-load', applyTheme);
    </script>
  </head>
  <body class="bg-base-100 text-base-content antialiased">
    <slot />
    <WhatsAppButton />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100vh;
  }
</style>
